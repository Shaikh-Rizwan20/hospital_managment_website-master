            .portfolio-container {
              display: grid;
              grid-template-columns: repeat(3, 1fr); /* 3 items per row */
              gap: 20px; /* Space between items */
              padding: 20px;
            }
            
            .single-pf {
              position: relative;
              text-align: center;
            }
            
            .single-pf img {
              width: 100%; /* Make the image responsive */
              height: auto;
            }
            
            .single-pf .btn {
              position: absolute;
              bottom: 10px;
              left: 50%;
              transform: translateX(-50%);
              background-color: rgba(0, 0, 0, 0.6);
              color: white;
              padding: 10px 20px;
              text-decoration: none;
              font-weight: bold;
              border-radius: 5px;
              transition: background-color 0.3s ease;
            }
            
            .single-pf .btn:hover {
              background-color: rgba(0, 0, 0, 0.8);
            }
            
            /* Make sure the layout is responsive */
            @media screen and (max-width: 768px) {
              .portfolio-container {
                grid-template-columns: repeat(2, 1fr); /* 2 items per row on smaller screens */
              }
            }
            
            @media screen and (max-width: 480px) {
              .portfolio-container {
                grid-template-columns: 1fr; /* 1 item per row on very small screens */
              }
            }
            
            /* Basic styles */
            .clients {
              padding: 50px 0;
              background-color: #f8f8f8;
            }
            
            .clients .clients-slider {
              display: flex;
              flex-wrap: nowrap;
              overflow: hidden; /* Hide overflow to show only one row of items */
              width: 100%;
            }
            
            .clients .single-clients {
              flex: 0 0 auto; /* Prevent the items from shrinking or growing */
              width: 20%; /* Adjust the width to fit 5 items on larger screens */
              text-align: center;
              padding: 0 10px;
            }
            
            .clients .single-clients img {
              width: 100%;
              max-width: 280px; /* Ensure consistent logo size */
              height: auto;
              margin: 0 auto;
              opacity: 0.8;
              transition: opacity 0.3s ease;
            }
            
            .clients .single-clients img:hover {
              opacity: 1;
            }
            
            /* CSS Animation for sliding effect */
            @keyframes slide {
              0% {
                transform: translateX(0);
              }
              100% {
                transform: translateX(-100%);
              }
            }
            
            .clients .clients-slider {
              animation: slide 30s infinite linear;
            }
            
            /* Make the layout responsive */
            @media screen and (max-width: 768px) {
              .clients .single-clients {
                width: 30%; /* Display 3 items on medium screens */
              }
            }
            
            @media screen and (max-width: 480px) {
              .clients .single-clients {
                width: 50%; /* Display 2 items on smaller screens */
