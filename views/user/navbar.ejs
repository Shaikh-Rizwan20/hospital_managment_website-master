    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        accent: {
                            emerald: '#10b981',
                            teal: '#14b8a6',
                        }
                    },
                    boxShadow: {
                        'glow': '0 10px 35px -5px rgba(14, 165, 233, 0.25)',
                        'card': '0 12px 30px -10px rgba(15, 23, 42, 0.08)',
                        'card-hover': '0 25px 45px -12px rgba(14, 165, 233, 0.2)',
