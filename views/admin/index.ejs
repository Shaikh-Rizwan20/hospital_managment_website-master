<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>WellCure Admin | Modern Healthcare Dashboard</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --admin-sidebar-width: 270px;
      --admin-topbar-height: 75px;
      --bg-dark: #090d16;
      --card-bg: rgba(18, 24, 38, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --topbar-bg: rgba(13, 17, 28, 0.85);
      --accent-gradient: linear-gradient(135deg, #6366f1, #d946ef);
      --cyan-gradient: linear-gradient(135deg, #06b6d4, #3b82f6);
      --emerald-gradient: linear-gradient(135deg, #10b981, #059669);
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    .mouse-spotlight {
      position: fixed;
      top: 0;
      left: 0;
      width: 650px;
      height: 650px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.14), rgba(217, 70, 239, 0.05), transparent 70%);
      pointer-events: none;
      transform: translate(-50%, -50%);
      z-index: 0;
      transition: width 0.3s ease, height 0.3s ease;
    }

    .app-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--admin-sidebar-width);
      background: rgba(13, 17, 28, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      z-index: 1050;
      transition: transform 0.35s ease;
    }

    .brand-section {
      height: var(--admin-topbar-height);
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      border-bottom: 1px solid var(--card-border);
    }

    .brand-link {
      font-size: 1.45rem;
      font-weight: 800;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sidebar-menu-wrapper {
      flex: 1;
      padding: 1.25rem 1rem;
      overflow-y: auto;
    }

    .nav-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #64748b;
      margin: 1rem 0 0.5rem 0.75rem;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      margin-bottom: 4px;
      color: var(--text-muted);
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .sidebar-link i {
      font-size: 1.05rem;
      width: 22px;
      text-align: center;
      color: #818cf8;
    }

    .sidebar-link:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      transform: translateX(4px);
    }

    .sidebar-link.active {
      background: var(--accent-gradient);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    }

    .sidebar-link.active i {
      color: #fff;
    }

    .app-topbar {
      position: fixed;
      top: 0;
      right: 0;
      left: var(--admin-sidebar-width);
      height: var(--admin-topbar-height);
      background: var(--topbar-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--card-border);
      z-index: 1040;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
    }

    .hospital-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.04);
      padding: 6px 14px;
      border-radius: 50px;
      border: 1px solid var(--card-border);
    }

    .hospital-badge .pulse-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      padding: 6px 14px 6px 8px;
      border-radius: 50px;
      cursor: pointer;
      color: var(--text-main);
    }

    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #818cf8;
    }

    .dropdown-menu-dark-custom {
      background: rgba(15, 23, 42, 0.95) !important;
      backdrop-filter: blur(20px);
      border: 1px solid var(--card-border) !important;
      border-radius: 16px !important;
      padding: 8px !important;
    }

    .dropdown-item-custom {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      color: var(--text-muted);
      border-radius: 10px;
      font-size: 0.88rem;
      text-decoration: none;
    }

    .dropdown-item-custom:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
    }

    .app-main-viewport {
      position: relative;
      z-index: 1;
      margin-left: var(--admin-sidebar-width);
      padding-top: calc(var(--admin-topbar-height) + 1.8rem);
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 3rem;
      min-height: 100vh;
    }

    .stat-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      transition: transform 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      color: #fff;
      margin-bottom: 1rem;
    }

    .stat-icon.cyan-bg { background: var(--cyan-gradient); }
    .stat-icon.magenta-bg { background: var(--accent-gradient); }
    .stat-icon.emerald-bg { background: var(--emerald-gradient); }

    .stat-number {
      font-size: 2.1rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 0.25rem;
    }

    .stat-label {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .mobile-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      z-index: 1045;
      display: none;
    }

    .mobile-overlay.active {
      display: block;
    }

    @media (max-width: 991.98px) {
      .app-sidebar { transform: translateX(-100%); }
      .app-sidebar.show { transform: translateX(0); }
      .app-topbar { left: 0; }
      .app-main-viewport { margin-left: 0; padding-left: 1rem; padding-right: 1rem; }
      .hospital-badge { display: none; }
    }
  </style>
</head>
<body>

  <!-- Sidebar Partial -->
  <%- include("../partials/sidebar", { activePage: 'dashboard' }) %>

  <!-- Topbar Partial -->
  <%- include("../partials/navbar") %>

  <!-- Main Viewport: ONLY Dashboard stat cards render here -->
  <main class="app-main-viewport">
    <div class="row g-4 mb-4">
      <div class="col-12 col-md-4">
        <div class="stat-card">
          <div class="stat-icon cyan-bg">
            <i class="fa-solid fa-bed-pulse"></i>
          </div>
          <div class="stat-number">
            <%= (typeof stats !== 'undefined' && stats.totalPatients != null) ? Number(stats.totalPatients).toLocaleString() : 0 %>
          </div>
          <div class="stat-label">Total Registered Patients</div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="stat-card">
          <div class="stat-icon magenta-bg">
            <i class="fa-solid fa-user-doctor"></i>
          </div>
          <div class="stat-number">
            <%= (typeof stats !== 'undefined' && stats.activeDoctors != null) ? Number(stats.activeDoctors).toLocaleString() : 0 %>
          </div>
          <div class="stat-label">Active Doctors & Specialists</div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="stat-card">
          <div class="stat-icon emerald-bg">
            <i class="fa-solid fa-hospital"></i>
          </div>
          <div class="stat-number">
            <%= (typeof stats !== 'undefined' && stats.hospitalDepartments != null) ? Number(stats.hospitalDepartments).toLocaleString() : 0 %>
          </div>
          <div class="stat-label">Hospital Departments</div>
        </div>
      </div>
         
      </div>

  <!-- Footer Partial closes the row, main, body, and html -->
  <%- include("../partials/footer") %>