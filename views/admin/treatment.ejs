<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Admin - Add New Treatment | WellCure</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --admin-sidebar-width: 270px;
      --admin-topbar-height: 75px;
      --bg-dark: #090d16;
      --card-bg: rgba(18, 24, 38, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --topbar-bg: rgba(13, 17, 28, 0.85);
      --input-bg: rgba(255, 255, 255, 0.04);
      --accent-gradient: linear-gradient(135deg, #6366f1, #d946ef);
      --accent-hover: linear-gradient(135deg, #4f46e5, #c026d3);
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    .mouse-spotlight {
      position: fixed;
      top: 0;
      left: 0;
      width: 650px;
      height: 650px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.14), rgba(217, 70, 239, 0.05), transparent 70%);
      pointer-events: none;
      transform: translate(-50%, -50%);
      z-index: 0;
    }

    .app-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--admin-sidebar-width);
      background: rgba(13, 17, 28, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      z-index: 1050;
      transition: transform 0.35s ease;
    }

    .brand-section {
      height: var(--admin-topbar-height);
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      border-bottom: 1px solid var(--card-border);
    }

    .brand-link {
      font-size: 1.45rem;
      font-weight: 800;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sidebar-menu-wrapper {
      flex: 1;
      padding: 1.25rem 1rem;
      overflow-y: auto;
    }

    .nav-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #64748b;
      margin: 1rem 0 0.5rem 0.75rem;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      margin-bottom: 4px;
      color: var(--text-muted);
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .sidebar-link i {
      font-size: 1.05rem;
      width: 22px;
      text-align: center;
      color: #818cf8;
    }

    .sidebar-link:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      transform: translateX(4px);
    }

    .sidebar-link.active {
      background: var(--accent-gradient);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    }

    .sidebar-link.active i {
      color: #fff;
    }

    .app-topbar {
      position: fixed;
      top: 0;
      right: 0;
      left: var(--admin-sidebar-width);
      height: var(--admin-topbar-height);
      background: var(--topbar-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--card-border);
      z-index: 1040;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
    }

    .hospital-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.04);
      padding: 6px 14px;
      border-radius: 50px;
      border: 1px solid var(--card-border);
    }

    .hospital-badge .pulse-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      padding: 6px 14px 6px 8px;
      border-radius: 50px;
      cursor: pointer;
      color: var(--text-main);
    }

    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #818cf8;
    }

    .dropdown-menu-dark-custom {
      background: rgba(15, 23, 42, 0.95) !important;
      backdrop-filter: blur(20px);
      border: 1px solid var(--card-border) !important;
      border-radius: 16px !important;
      padding: 8px !important;
    }

    .dropdown-item-custom {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      color: var(--text-muted);
      border-radius: 10px;
      font-size: 0.88rem;
      text-decoration: none;
    }

    .dropdown-item-custom:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
    }

    .app-main-viewport {
      position: relative;
      z-index: 1;
      margin-left: var(--admin-sidebar-width);
      padding-top: calc(var(--admin-topbar-height) + 1.8rem);
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 3rem;
      min-height: 100vh;
    }

    .form-container {
      width: 100%;
      max-width: 960px;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 2.5rem 3rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(99, 102, 241, 0.1);
    }

    .form-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .form-header h2 {
      font-size: 1.85rem;
      font-weight: 700;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .form-header p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .section-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #38bdf8;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 1.5rem 0 1rem;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--card-border);
    }

    label {
      font-size: 0.86rem;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .form-control, .form-select {
      background-color: var(--input-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      color: #f8fafc;
      padding: 10px 14px;
      font-size: 0.92rem;
    }

    .form-control:focus, .form-select:focus {
      background-color: rgba(255, 255, 255, 0.07);
      border-color: #818cf8;
      box-shadow: 0 0 0 4px rgba(129, 140, 248, 0.2);
      color: #fff;
    }

    .form-select option {
      background-color: #0f172a;
      color: #f8fafc;
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(0.85);
      cursor: pointer;
    }

    textarea.form-control {
      resize: vertical;
      min-height: 100px;
    }

    .btn-submit {
      background: var(--accent-gradient);
      color: #ffffff;
      font-size: 1rem;
      font-weight: 700;
      border: none;
      border-radius: 14px;
      padding: 14px;
      width: 100%;
      margin-top: 1.5rem;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
    }

    .btn-submit:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(217, 70, 239, 0.45);
      color: #fff;
    }

    .mobile-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      z-index: 1045;
      display: none;
    }

    .mobile-overlay.active {
      display: block;
    }

    @media (max-width: 991.98px) {
      .app-sidebar { transform: translateX(-100%); }
      .app-sidebar.show { transform: translateX(0); }
      .app-topbar { left: 0; padding: 0 1.25rem; }
      .app-main-viewport { margin-left: 0; padding: calc(var(--admin-topbar-height) + 1rem) 1rem 2rem 1rem; }
      .form-container { padding: 1.8rem 1.4rem; border-radius: 18px; }
      .form-header h2 { font-size: 1.5rem; }
      .hospital-badge { display: none; }
    }
  </style>
</head>
<body>

  <!-- 1. Sidebar -->
  <%- include("../partials/sidebar", { activePage: 'treatment' }) %>

  <!-- 2. Topbar -->
  <%- include("../partials/navbar") %>

  <!-- 3. Form Content inside Viewport -->
  <main class="app-main-viewport">
    <div class="row w-100 justify-content-center m-0">
      <div class="form-container">
        <div class="form-header">
          <h2><i class="fa-solid fa-notes-medical me-2"></i>Add New Treatment</h2>
          <p>Configure medical procedures, clinician assignments, and pricing parameters.</p>
        </div>

        <form action="/admin/add_treatment" method="POST">
          <!-- Basic Treatment Information -->
          <div class="section-title">
            <i class="fa-solid fa-circle-info"></i> Basic Treatment Information
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="treatment_name">Treatment Name <span class="text-danger">*</span></label>
              <input type="text" id="treatment_name" name="treatment_name" class="form-control" placeholder="e.g. Total Hip Replacement" required>
            </div>
            <div class="col-md-6">
              <label for="treatment_type">Treatment Type <span class="text-danger">*</span></label>
              <select id="treatment_type" name="treatment_type" class="form-select" required>
                <option value="" disabled selected>Select category...</option>
                <option value="Surgery">Surgery</option>
                <option value="Medication">Medication</option>
                <option value="Therapy">Therapy</option>
                <option value="Diagnostic">Diagnostic</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="col-12">
              <label for="treatment_description">Treatment Description <span class="text-danger">*</span></label>
              <textarea id="treatment_description" name="treatment_description" class="form-control" rows="3" placeholder="Provide clinical scope, expectations, and indications..." required></textarea>
            </div>
          </div>

          <!-- Eligibility, Duration & Financials -->
          <div class="section-title mt-4">
            <i class="fa-solid fa-stethoscope"></i> Eligibility, Duration & Financials
          </div>
          <div class="row g-3">
            <div class="col-md-4">
              <label for="treatment_duration">Duration <span class="text-danger">*</span></label>
              <input type="text" id="treatment_duration" name="treatment_duration" class="form-control" placeholder="e.g. 45 mins / 3 weeks" required>
            </div>
            <div class="col-md-4">
              <label for="treatment_cost">Cost (USD)</label>
              <input type="number" step="0.01" id="treatment_cost" name="treatment_cost" class="form-control" placeholder="0.00">
            </div>
            <div class="col-md-4">
              <label for="insurance_coverage">Insurance Coverage</label>
              <select id="insurance_coverage" name="insurance_coverage" class="form-select">
                <option value="Yes">Yes (Full)</option>
                <option value="Partial">Partial</option>
                <option value="No">No (Out-of-pocket)</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="age_group">Target Age Group</label>
              <select id="age_group" name="age_group" class="form-select">
                <option value="All Ages">All Ages</option>
                <option value="Children">Children</option>
                <option value="Adults">Adults</option>
                <option value="Elderly">Elderly</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="gender">Gender Eligibility</label>
              <select id="gender" name="gender" class="form-select">
                <option value="Both">All / Any</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <!-- Clinician Assignment & Logistics -->
          <div class="section-title mt-4">
            <i class="fa-solid fa-user-doctor"></i> Clinician Assignment & Logistics
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="assigned_doctor">Assigned Doctor <span class="text-danger">*</span></label>
              <select id="assigned_doctor" name="assigned_doctor" class="form-select" required>
                <option value="" disabled selected>Choose physician...</option>
                <option value="doctor1">Dr. Smith</option>
                <option value="doctor2">Dr. Johnson</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="specialization">Doctor's Specialization <span class="text-danger">*</span></label>
              <input type="text" id="specialization" name="specialization" class="form-control" placeholder="e.g. Cardiology, Orthopedics" required>
            </div>
            <div class="col-md-4">
              <label for="available_from">Available From <span class="text-danger">*</span></label>
              <input type="date" id="available_from" name="available_from" class="form-control" required>
            </div>
            <div class="col-md-4">
              <label for="available_to">Available To</label>
              <input type="date" id="available_to" name="available_to" class="form-control">
            </div>
            <div class="col-md-4">
              <label for="location">Location / Ward</label>
              <input type="text" id="location" name="location" class="form-control" placeholder="e.g. Building B, Room 302">
            </div>
            <div class="col-12">
              <label for="notes">Additional Clinical Notes</label>
              <textarea id="notes" name="notes" class="form-control" rows="2" placeholder="Preparation instructions, contraindications, or specific requirements..."></textarea>
            </div>
          </div>

          <button type="submit" class="btn-submit">
            <i class="fa-solid fa-plus"></i> Save & Publish Treatment
          </button>
        </form>
      </div>

  <!-- 4. Footer Partial closes row, main, body, and html -->
  <%- include("../partials/footer") %>