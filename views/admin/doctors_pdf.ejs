<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Doctors List PDF</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        h2 {
            text-align: center;
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        white-space: inherit;
        }
        table, th, td {
            border: 1px solid #333;
        }
        th, td {
            padding: 8px;
            text-align: center;
        }
        thead {
            background-color: #f0f0f0;
        }
    </style>
</head>
<body>
    <h2>Doctors List</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Age</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Marital Status</th>
                <th>Qualification</th>
                <th>Country</th>
                <th>State</th>
                <th>City</th>
            </tr>
        </thead>
        <tbody>
            <% doctors_info.forEach(function(doctor) { %>
                <tr>
                    <td><%= doctor.doctor_id %></td>
                    <td><%= doctor.first_name %></td>
                    <td><%= doctor.last_name %></td>
                    <td><%= doctor.age %></td>
                    <td><%= doctor.email %></td>
                    <td><%= doctor.mobile %></td>
                    <td><%= doctor.marital_status %></td>
                    <td><%= doctor.qualification %></td>
                    <td><%= doctor.country %></td>
                    <td><%= doctor.state %></td>
                    <td><%= doctor.city %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>
