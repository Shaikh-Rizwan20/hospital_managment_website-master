<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Credentialing & Clinical Privileges | WellCure Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(17, 24, 39, 0.75);
      --border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #6366f1;
      --danger: #ef4444;
      --warning: #f59e0b;
      --info: #38bdf8;
      --success: #10b981;
    }
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Plus Jakarta Sans', sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 30px; min-height: 100vh; }

    .top-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .back-link { color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 6px; }
    .back-link:hover { color: #fff; }

    /* Top Stats Grid */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 30px; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 20px; backdrop-filter: blur(12px); }
    .stat-card h3 { font-size: 13px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }
    .stat-card p { font-size: 28px; font-weight: 800; }

    /* Table Container */
    .table-container { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 24px; overflow-x: auto; backdrop-filter: blur(12px); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
    th { padding: 14px 16px; color: var(--text-muted); font-size: 12px; text-transform: uppercase; border-bottom: 1px solid var(--border); }
    td { padding: 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child td { border-bottom: none; }

    .badge-status { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-block; }
    .status-Privileged---Active { background: rgba(16, 185, 129, 0.15); color: var(--success); }
    .status-Renewal-Pending { background: rgba(245, 158, 11, 0.15); color: var(--warning); border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-Credential-Expired { background: rgba(239, 68, 68, 0.2); color: var(--danger); animation: pulse 1.5s infinite; border: 1px solid rgba(239, 68, 68, 0.4); }
    .status-Privileges-Suspended { background: rgba(148, 163, 184, 0.15); color: var(--text-muted); }

    @keyframes pulse { 0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; } }

    .btn { padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-edit { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); }
    .btn-delete { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    /* Modal Form Elements */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); justify-content: center; align-items: center; z-index: 1000; }
    .modal-box { background: #111827; border: 1px solid var(--border); border-radius: 18px; width: 500px; max-height: 90vh; overflow-y: auto; padding: 26px; color: #fff; }
    .form-group { margin-bottom: 12px; display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 12px; color: var(--text-muted); }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: #090d16; color: #fff; font-size: 13px; outline: none; }
  </style>
</head>
<body>

  <div class="top-header">
    <div>
      <a href="/admin/l_login" class="back-link"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
      <h1 style="font-size: 24px; font-weight: 800;">Staff Credentialing & Clinical Privileging</h1>
    </div>
    <button class="btn btn-primary" onclick="document.getElementById('credModal').style.display='flex'">
      <i class="fa-solid fa-user-check"></i> Grant Clinical Privilege
    </button>
  </div>

  <!-- Dynamic Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Credentialed Clinicians</h3>
      <p><%= stats.total_credentialed %></p>
    </div>
    <div class="stat-card">
      <h3>Active Privileges</h3>
      <p style="color: var(--success);"><%= stats.active_privileges %></p>
    </div>
    <div class="stat-card">
      <h3>Licensure Renewals (&lt;60d)</h3>
      <p style="color: var(--warning);"><%= stats.renewals_due %></p>
    </div>
    <div class="stat-card">
      <h3>Expired Registrations</h3>
      <p style="color: var(--danger);"><%= stats.expired_licenses %></p>
    </div>
  </div>

  <!-- Table Container -->
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Clinician & Role</th>
          <th>Council Registration #</th>
          <th>Department</th>
          <th>Licensure Expiry</th>
          <th>Approved Clinical Privileges</th>
          <th>Privileging Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (staff && staff.length > 0) { %>
          <% staff.forEach(s => { 
              const isExp = new Date(s.license_expiry_date) < new Date();
          %>
            <tr>
              <td>
                <strong><%= s.doctor_name %></strong>
                <div style="font-size: 12px; color: var(--info);"><%= s.staff_role %></div>
              </td>
              <td>
                <div style="font-family: monospace; font-weight: bold;"><%= s.council_registration_no %></div>
                <small style="color: var(--text-muted);"><%= s.state_medical_council %></small>
              </td>
              <td><strong><%= s.department %></strong></td>
              <td>
                <div style="font-weight: 700; color: <%= isExp ? 'var(--danger)' : 'var(--text)' %>;">
                  <%= new Date(s.license_expiry_date).toISOString().slice(0, 10) %>
                </div>
                <small style="color: var(--text-muted);">Indemnity: <%= new Date(s.indemnity_expiry_date).toISOString().slice(0, 10) %></small>
              </td>
              <td style="max-width: 260px; font-size: 12px; color: #cbd5e1;">
                <%= s.approved_clinical_privileges %>
              </td>
              <td>
                <span class="badge-status <%= s.credentialing_status.includes('Active') ? 'status-Privileged---Active' : (s.credentialing_status.includes('Pending') ? 'status-Renewal-Pending' : 'status-Credential-Expired') %>">
                  <%= s.credentialing_status %>
                </span>
              </td>
              <td>
                <div style="display: flex; gap: 6px;">
                  <button class="btn btn-edit" onclick="openPrivilegeModal('<%= s.credential_id %>', '<%= s.doctor_name %>', '<%= s.credentialing_status %>', `<%= s.approved_clinical_privileges %>`, '<%= new Date(s.license_expiry_date).toISOString().slice(0, 10) %>', '<%= new Date(s.indemnity_expiry_date).toISOString().slice(0, 10) %>')">
                    <i class="fa-solid fa-stamp"></i> Review
                  </button>
                  <a href="/admin/staff_credentials/delete/<%= s.credential_id %>" class="btn btn-delete" onclick="return confirm('Deregister clinical privileges for this practitioner?')">
                    <i class="fa-solid fa-trash"></i>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">
              No staff credentials logged. Click "Grant Clinical Privilege" to add a clinician.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Modal: Grant Privileges -->
  <div id="credModal" class="modal-overlay">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="font-size:18px;">Grant Clinical Privileging</h3>
        <span onclick="document.getElementById('credModal').style.display='none'" style="cursor:pointer; font-size:20px; color:var(--text-muted);">&times;</span>
      </div>

      <form action="/admin/staff_credentials/save" method="POST">
        <div class="form-group">
          <label>Clinician Full Name</label>
          <input type="text" name="doctor_name" placeholder="e.g. Dr. Rizwan / Dr. Specialist" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Clinical Role</label>
            <select name="staff_role" required>
              <option value="Surgeon">Surgeon</option>
              <option value="Attending Consultant">Attending Consultant</option>
              <option value="Anesthesiologist">Anesthesiologist</option>
              <option value="Resident Medical Officer (RMO)">Resident Medical Officer (RMO)</option>
              <option value="Specialist Nurse">Specialist Nurse</option>
            </select>
          </div>
          <div class="form-group">
            <label>Primary Department</label>
            <select name="department" required>
              <% departments.forEach(d => { %>
                <option value="<%= d.department_name %>"><%= d.department_name %></option>
              <% }) %>
              <option value="General Surgery">General Surgery</option>
              <option value="Cardiology">Cardiology</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Medical Council Reg #</label>
            <input type="text" name="council_registration_no" placeholder="MMC-XXXX-XXXXX" required>
          </div>
          <div class="form-group">
            <label>Registration Council</label>
            <input type="text" name="state_medical_council" value="Maharashtra Medical Council (MMC)" required>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Licensure Expiry Date</label>
            <input type="date" name="license_expiry_date" required>
          </div>
          <div class="form-group">
            <label>Indemnity Expiry Date</label>
            <input type="date" name="indemnity_expiry_date" required>
          </div>
        </div>

        <div class="form-group">
          <label>Medical Indemnity Policy No.</label>
          <input type="text" name="indemnity_insurance_policy" placeholder="POL-MED-XXXXX">
        </div>

        <div class="form-group">
          <label>Approved Clinical Scope / Privileges</label>
          <textarea name="approved_clinical_privileges" rows="3" placeholder="List authorized surgical procedures, diagnostic scopes, and interventions..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          Authorize & Sign Credential Record
        </button>
      </form>
    </div>
  </div>

  <!-- Modal: Review / Update Privileges -->
  <div id="reviewModal" class="modal-overlay">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="font-size:18px;" id="modalDoctorTitle">Review Clinical Privileging</h3>
        <span onclick="document.getElementById('reviewModal').style.display='none'" style="cursor:pointer; font-size:20px; color:var(--text-muted);">&times;</span>
      </div>

      <form action="/admin/staff_credentials/update-status" method="POST">
        <input type="hidden" name="credential_id" id="modalCredId">

        <div class="form-group">
          <label>Credentialing Status</label>
          <select name="credentialing_status" id="modalStatus" required>
            <option value="Privileged & Active">Privileged & Active</option>
            <option value="Renewal Pending (<60 Days)">Renewal Pending (<60 Days)</option>
            <option value="Credential Expired">Credential Expired</option>
            <option value="Privileges Suspended">Privileges Suspended</option>
          </select>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Licensure Expiry Date</label>
            <input type="date" name="license_expiry_date" id="modalLicDate" required>
          </div>
          <div class="form-group">
            <label>Indemnity Expiry Date</label>
            <input type="date" name="indemnity_expiry_date" id="modalIndDate" required>
          </div>
        </div>

        <div class="form-group">
          <label>Approved Scope of Clinical Privileges</label>
          <textarea name="approved_clinical_privileges" id="modalPrivileges" rows="4" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          Save Re-Credentialing Review
        </button>
      </form>
    </div>
  </div>

  <script>
    function openPrivilegeModal(id, name, status, privileges, licDate, indDate) {
      document.getElementById('modalCredId').value = id;
      document.getElementById('modalDoctorTitle').innerText = 'Privileges: ' + name;
      document.getElementById('modalStatus').value = status;
      document.getElementById('modalPrivileges').value = privileges;
      document.getElementById('modalLicDate').value = licDate;
      document.getElementById('modalIndDate').value = indDate;
      document.getElementById('reviewModal').style.display = 'flex';
    }
  </script>

</body>
</html>