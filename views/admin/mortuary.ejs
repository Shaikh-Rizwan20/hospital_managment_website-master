<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mortuary & Death Registry | WellCure Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(17, 24, 39, 0.75);
      --border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #6366f1;
      --cold-blue: #38bdf8;
      --warning: #f59e0b;
      --success: #10b981;
      --danger: #ef4444;
    }
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Plus Jakarta Sans', sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 30px; min-height: 100vh; }

    .top-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .back-link { color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 6px; }
    .back-link:hover { color: #fff; }

    /* Top Stats Grid */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 30px; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 20px; backdrop-filter: blur(12px); }
    .stat-card h3 { font-size: 13px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }
    .stat-card p { font-size: 28px; font-weight: 800; }

    /* Table Container */
    .table-container { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 24px; overflow-x: auto; backdrop-filter: blur(12px); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
    th { padding: 14px 16px; color: var(--text-muted); font-size: 12px; text-transform: uppercase; border-bottom: 1px solid var(--border); }
    td { padding: 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child td { border-bottom: none; }

    .badge-status { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; display: inline-block; }
    .status-In-Mortuary-Chamber { background: rgba(56, 189, 248, 0.15); color: var(--cold-blue); border: 1px solid rgba(56, 189, 248, 0.3); }
    .status-Autopsy---MLC-Pending { background: rgba(245, 158, 11, 0.15); color: var(--warning); border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-Released-to-Family { background: rgba(16, 185, 129, 0.15); color: var(--success); }
    .status-Transferred-to-Authorities { background: rgba(239, 68, 68, 0.15); color: var(--danger); }

    .status-select { background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; }

    .btn { padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-delete { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    /* Modal Form Elements */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); justify-content: center; align-items: center; z-index: 1000; }
    .modal-box { background: #111827; border: 1px solid var(--border); border-radius: 18px; width: 480px; max-height: 90vh; overflow-y: auto; padding: 26px; color: #fff; }
    .form-group { margin-bottom: 12px; display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 12px; color: var(--text-muted); }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: #090d16; color: #fff; font-size: 13px; outline: none; }
  </style>
</head>
<body>

  <div class="top-header">
    <div>
      <a href="/admin/l_login" class="back-link"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
      <h1 style="font-size: 24px; font-weight: 800;">Hospital Mortuary & Deceased Registry</h1>
    </div>
    <button class="btn btn-primary" onclick="document.getElementById('mortModal').style.display='flex'">
      <i class="fa-solid fa-file-circle-plus"></i> Register Death & Chamber
    </button>
  </div>

  <!-- Dynamic Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Cumulative Records</h3>
      <p><%= stats.total_records %></p>
    </div>
    <div class="stat-card">
      <h3>In Cold Chambers</h3>
      <p style="color: var(--cold-blue);"><%= stats.in_chamber_count %></p>
    </div>
    <div class="stat-card">
      <h3>Autopsy / MLC Pending</h3>
      <p style="color: var(--warning);"><%= stats.mlc_pending_count %></p>
    </div>
    <div class="stat-card">
      <h3>Released to Relatives</h3>
      <p style="color: var(--success);"><%= stats.released_count %></p>
    </div>
  </div>

  <!-- Registry Table -->
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Deceased Details</th>
          <th>Age / Gender</th>
          <th>Time of Death</th>
          <th>Clinical Cause of Death</th>
          <th>Chamber Allocation</th>
          <th>Next-of-Kin Contact</th>
          <th>Custody Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (records && records.length > 0) { %>
          <% records.forEach(r => { %>
            <tr>
              <td>
                <strong><%= r.patient_name %></strong>
                <div style="font-size: 12px; color: var(--text-muted);"><%= r.deceased_code %></div>
              </td>
              <td><%= r.age %> yrs / <%= r.gender %></td>
              <td>
                <div><%= new Date(r.date_of_death).toLocaleDateString() %></div>
                <small style="color: var(--text-muted);"><%= new Date(r.date_of_death).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
              </td>
              <td style="max-width: 220px; font-size: 13px; color: #cbd5e1;">
                <%= r.cause_of_death %>
                <div style="font-size: 11px; color: #818cf8; margin-top: 4px;">Dr: <%= r.certifying_doctor %></div>
              </td>
              <td>
                <span style="font-weight: bold; color: var(--cold-blue);"><i class="fa-solid fa-snowflake"></i> <%= r.freezer_chamber_no %></span>
              </td>
              <td style="font-size: 13px;">
                <div><%= r.next_of_kin_name %></div>
                <small style="color: var(--text-muted);"><%= r.next_of_kin_contact %></small>
              </td>
              <td>
                <form action="/admin/mortuary/update-status" method="POST">
                  <input type="hidden" name="mortuary_id" value="<%= r.mortuary_id %>">
                  <select name="status" onchange="this.form.submit()" class="status-select">
                    <option value="In Mortuary Chamber" <%= r.status === 'In Mortuary Chamber' ? 'selected' : '' %>>In Mortuary Chamber</option>
                    <option value="Autopsy / MLC Pending" <%= r.status === 'Autopsy / MLC Pending' ? 'selected' : '' %>>Autopsy / MLC Pending</option>
                    <option value="Released to Family" <%= r.status === 'Released to Family' ? 'selected' : '' %>>Released to Family</option>
                    <option value="Transferred to Authorities" <%= r.status === 'Transferred to Authorities' ? 'selected' : '' %>>Transferred to Authorities</option>
                  </select>
                </form>
              </td>
              <td>
                <a href="/admin/mortuary/delete/<%= r.mortuary_id %>" class="btn btn-delete" onclick="return confirm('Delete this deceased registry entry?')">
                  <i class="fa-solid fa-trash"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 30px;">
              No deceased records registered. Click "Register Death & Chamber" to log a record.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Modal: Register Death -->
  <div id="mortModal" class="modal-overlay">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="font-size:18px;">Register Deceased Patient</h3>
        <span onclick="document.getElementById('mortModal').style.display='none'" style="cursor:pointer; font-size:20px; color:var(--text-muted);">&times;</span>
      </div>

      <form action="/admin/mortuary/save" method="POST">
        <div class="form-group">
          <label>Deceased Patient Name</label>
          <input type="text" name="patient_name" placeholder="Full Legal Name" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Gender</label>
            <select name="gender" required>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Age</label>
            <input type="number" name="age" placeholder="Age in years" required>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Date & Time of Death</label>
            <input type="datetime-local" name="date_of_death" required>
          </div>
          <div class="form-group">
            <label>Freezer Chamber</label>
            <select name="freezer_chamber_no" required>
              <option value="Chamber-01">Chamber-01 (Unit A)</option>
              <option value="Chamber-02">Chamber-02 (Unit A)</option>
              <option value="Chamber-03">Chamber-03 (Unit B)</option>
              <option value="Chamber-04">Chamber-04 (Unit B)</option>
              <option value="Chamber-05">Chamber-05 (Deep Freeze)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Certifying Physician</label>
          <select name="certifying_doctor" required>
            <% doctors.forEach(d => { %>
              <option value="Dr. <%= d.first_name %> <%= d.last_name %>">Dr. <%= d.first_name %> <%= d.last_name %></option>
            <% }) %>
            <option value="Dr. Rizwan">Dr. Rizwan</option>
          </select>
        </div>

        <div class="form-group">
          <label>Primary Clinical Cause of Death</label>
          <textarea name="cause_of_death" rows="2" placeholder="Clinical sequence, secondary conditions, or trauma assessment..." required></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Next-of-Kin Name & Relation</label>
            <input type="text" name="next_of_kin_name" placeholder="e.g. Suresh Patil (Husband)" required>
          </div>
          <div class="form-group">
            <label>Contact Phone</label>
            <input type="tel" name="next_of_kin_contact" placeholder="+91 98220 XXXXX" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          Register to Mortuary Cold Chamber
        </button>
      </form>
    </div>
  </div>

</body>
</html>