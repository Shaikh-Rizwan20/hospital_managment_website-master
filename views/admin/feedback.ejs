<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Patient Feedback & Grievances | WellCure Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(17, 24, 39, 0.75);
      --border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #6366f1;
      --gold: #f59e0b;
      --success: #10b981;
      --danger: #ef4444;
    }
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Plus Jakarta Sans', sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 30px; min-height: 100vh; }

    .top-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .back-link { color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 6px; }
    .back-link:hover { color: #fff; }

    /* Top Stats Grid */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 30px; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 20px; backdrop-filter: blur(12px); }
    .stat-card h3 { font-size: 13px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }
    .stat-card p { font-size: 28px; font-weight: 800; }

    /* Table Container */
    .table-container { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 24px; overflow-x: auto; backdrop-filter: blur(12px); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
    th { padding: 14px 16px; color: var(--text-muted); font-size: 12px; text-transform: uppercase; border-bottom: 1px solid var(--border); }
    td { padding: 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child td { border-bottom: none; }

    .stars { color: var(--gold); font-size: 13px; }
    .badge-cat { padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; display: inline-block; }
    .cat-Compliment { background: rgba(16, 185, 129, 0.15); color: var(--success); }
    .cat-Feedback { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
    .cat-Complaint { background: rgba(239, 68, 68, 0.15); color: var(--danger); }

    .status-select { background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; }

    .btn { padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-delete { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    /* Modal Form Elements */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); justify-content: center; align-items: center; z-index: 1000; }
    .modal-box { background: #111827; border: 1px solid var(--border); border-radius: 18px; width: 450px; padding: 26px; color: #fff; }
    .form-group { margin-bottom: 12px; display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 12px; color: var(--text-muted); }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: #090d16; color: #fff; font-size: 13px; outline: none; }
  </style>
</head>
<body>

  <div class="top-header">
    <div>
      <a href="/admin/l_login" class="back-link"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
      <h1 style="font-size: 24px; font-weight: 800;">Patient Feedback & Quality of Care</h1>
    </div>
    <button class="btn btn-primary" onclick="document.getElementById('feedbackModal').style.display='flex'">
      <i class="fa-solid fa-pen-nib"></i> Log Feedback
    </button>
  </div>

  <!-- Dynamic Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Average Score</h3>
      <p style="color: var(--gold);"><i class="fa-solid fa-star"></i> <%= stats.average_rating %> / 5.0</p>
    </div>
    <div class="stat-card">
      <h3>Total Reviews</h3>
      <p><%= stats.total_feedbacks %></p>
    </div>
    <div class="stat-card">
      <h3>5-Star Ratings</h3>
      <p style="color: var(--success);"><%= stats.five_star_count %></p>
    </div>
    <div class="stat-card">
      <h3>Open Grievances</h3>
      <p style="color: var(--danger);"><%= stats.open_grievances %></p>
    </div>
  </div>

  <!-- Table Container -->
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Patient Name</th>
          <th>Department & Attending</th>
          <th>Rating</th>
          <th>Feedback Type</th>
          <th>Patient Comments</th>
          <th>Redressal Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (feedbacks && feedbacks.length > 0) { %>
          <% feedbacks.forEach(f => { %>
            <tr>
              <td>
                <strong><%= f.patient_name %></strong>
                <div style="font-size: 11px; color: var(--text-muted);"><%= f.patient_contact %></div>
              </td>
              <td>
                <div><%= f.department %></div>
                <small style="color: var(--text-muted);"><%= f.doctor_name %></small>
              </td>
              <td>
                <div class="stars">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <i class="fa-solid fa-star" style="color: <%= i <= f.overall_rating ? '#f59e0b' : '#334155' %>;"></i>
                  <% } %>
                </div>
              </td>
              <td>
                <span class="badge-cat <%= f.category === 'Compliment' ? 'cat-Compliment' : (f.category.includes('Complaint') ? 'cat-Complaint' : 'cat-Feedback') %>">
                  <%= f.category %>
                </span>
              </td>
              <td style="max-width: 250px; font-size: 13px; color: #cbd5e1;">
                "<%= f.comments %>"
              </td>
              <td>
                <form action="/admin/feedback/update-status" method="POST">
                  <input type="hidden" name="feedback_id" value="<%= f.feedback_id %>">
                  <select name="resolution_status" onchange="this.form.submit()" class="status-select">
                    <option value="Under Review" <%= f.resolution_status === 'Under Review' ? 'selected' : '' %>>Under Review</option>
                    <option value="Action Taken" <%= f.resolution_status === 'Action Taken' ? 'selected' : '' %>>Action Taken</option>
                    <option value="Resolved" <%= f.resolution_status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                    <option value="Closed" <%= f.resolution_status === 'Closed' ? 'selected' : '' %>>Closed</option>
                  </select>
                </form>
              </td>
              <td>
                <a href="/admin/feedback/delete/<%= f.feedback_id %>" class="btn btn-delete" onclick="return confirm('Remove feedback record?')">
                  <i class="fa-solid fa-trash"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">
              No feedback entries recorded yet. Click "Log Feedback" to register patient reviews.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Modal: Log Feedback -->
  <div id="feedbackModal" class="modal-overlay">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="font-size:18px;">Log Patient Feedback</h3>
        <span onclick="document.getElementById('feedbackModal').style.display='none'" style="cursor:pointer; font-size:20px; color:var(--text-muted);">&times;</span>
      </div>

      <form action="/admin/feedback/save" method="POST">
        <div class="form-group">
          <label>Patient Full Name</label>
          <input type="text" name="patient_name" placeholder="Patient Name" required>
        </div>

        <div class="form-group">
          <label>Contact Number</label>
          <input type="tel" name="patient_contact" placeholder="+91 98221 XXXXX" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Department</label>
            <select name="department" required>
              <% departments.forEach(d => { %>
                <option value="<%= d.department_name %>"><%= d.department_name %></option>
              <% }) %>
              <option value="Emergency">Emergency</option>
              <option value="OPD">OPD</option>
              <option value="Billing & Invoices">Billing & Invoices</option>
              <option value="General Ward">General Ward</option>
            </select>
          </div>
          <div class="form-group">
            <label>Rating (1 to 5 Stars)</label>
            <select name="overall_rating" required>
              <option value="5">★★★★★ (5 Stars - Excellent)</option>
              <option value="4">★★★★☆ (4 Stars - Good)</option>
              <option value="3">★★★☆☆ (3 Stars - Average)</option>
              <option value="2">★★☆☆☆ (2 Stars - Poor)</option>
              <option value="1">★☆☆☆☆ (1 Star - Critical)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Feedback Category</label>
          <select name="category" required>
            <option value="Compliment">Compliment / Appreciation</option>
            <option value="General Feedback">General Feedback</option>
            <option value="Complaint / Grievance">Complaint / Grievance</option>
          </select>
        </div>

        <div class="form-group">
          <label>Comments / Patient Experience</label>
          <textarea name="comments" rows="3" placeholder="Describe clinical experience, staff behavior, waiting time..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          Save Feedback
        </button>
      </form>
    </div>
  </div>

</body>
</html>