<%- include("index.ejs") %>

<style>
  :root {
    --admin-sidebar-width: 270px;
    --admin-topbar-height: 75px;
    --card-bg: rgba(18, 24, 38, 0.85);
    --card-border: rgba(255, 255, 255, 0.08);
    --input-bg: rgba(255, 255, 255, 0.04);
    --accent-gradient: linear-gradient(135deg, #6366f1, #d946ef);
  }

  .invoice-form-viewport {
    margin-left: var(--admin-sidebar-width);
    padding-top: calc(var(--admin-topbar-height) + 1.8rem);
    padding-left: 2rem;
    padding-right: 2rem;
    padding-bottom: 4rem;
    min-height: 100vh;
  }

  .glass-card {
    max-width: 1000px;
    margin: 0 auto;
    background: var(--card-bg);
    backdrop-filter: blur(18px);
    border: 1px solid var(--card-border);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
  }

  .form-control-custom, .form-select-custom {
    width: 100%;
    background-color: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    color: #f8fafc;
    padding: 10px 14px;
    font-size: 0.92rem;
  }

  .form-control-custom:focus, .form-select-custom:focus {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: #818cf8;
    color: #fff;
    outline: none;
  }

  .form-select-custom option {
    background: #0f172a;
  }

  .section-label {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #38bdf8;
    font-weight: 700;
    margin: 1.8rem 0 1rem;
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 6px;
  }

  .btn-submit {
    background: var(--accent-gradient);
    color: #fff;
    font-weight: 700;
    border: none;
    border-radius: 14px;
    padding: 14px;
    width: 100%;
    margin-top: 2rem;
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
  }

  @media (max-width: 991.98px) {
    .invoice-form-viewport { margin-left: 0; padding: 1rem; }
  }
</style>

<div class="invoice-form-viewport">
  <div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2 class="text-white fw-bold mb-1"><i class="fa-solid fa-receipt me-2"></i>Generate Patient Invoice</h2>
        <p class="text-secondary small mb-0">Record clinical treatments, medications, and insurance charges.</p>
      </div>
      <a href="/admin/billing" class="btn btn-outline-light btn-sm rounded-pill px-3">Back to List</a>
    </div>

    <form action="/admin/billing/save" method="POST" id="invoiceForm">
      <input type="hidden" name="items" id="itemsPayload">

      <!-- Patient Information -->
      <div class="section-label">Patient & Physician Assignment</div>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="text-secondary small fw-bold mb-1">Patient Full Name *</label>
          <input type="text" name="patient_name" class="form-control-custom" required placeholder="Johnathan Doe">
        </div>
        <div class="col-md-4">
          <label class="text-secondary small fw-bold mb-1">Patient Email</label>
          <input type="email" name="patient_email" class="form-control-custom" placeholder="patient@example.com">
        </div>
        <div class="col-md-4">
          <label class="text-secondary small fw-bold mb-1">Patient Phone</label>
          <input type="text" name="patient_phone" class="form-control-custom" placeholder="+1 (555) 000-0000">
        </div>
        <div class="col-md-6">
          <label class="text-secondary small fw-bold mb-1">Attending Doctor</label>
          <select name="doctor_id" id="doctorSelect" class="form-select-custom" onchange="syncDoctorName()">
            <option value="" data-name="">Select Physician...</option>
            <% doctors.forEach(function(doc) { %>
              <option value="<%= doc.doctor_id %>" data-name="<%= doc.first_name %> <%= doc.last_name %>">
                Dr. <%= doc.first_name %> <%= doc.last_name %>
              </option>
            <% }); %>
          </select>
          <input type="hidden" name="doctor_name" id="doctorNameInput">
        </div>
        <div class="col-md-3">
          <label class="text-secondary small fw-bold mb-1">Invoice Date *</label>
          <input type="date" name="invoice_date" class="form-control-custom" required value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
        <div class="col-md-3">
          <label class="text-secondary small fw-bold mb-1">Due Date</label>
          <input type="date" name="due_date" class="form-control-custom">
        </div>
      </div>

      <!-- Itemized Billing Line Items -->
      <div class="section-label">Billable Line Items</div>
      <div id="itemsContainer">
        <!-- Default Row -->
        <div class="row g-2 align-items-center mb-2 item-row">
          <div class="col-md-4">
            <input type="text" class="form-control-custom item-desc" placeholder="Service / Procedure" required>
          </div>
          <div class="col-md-3">
            <select class="form-select-custom item-type">
              <option value="Treatment">Treatment</option>
              <option value="Consultation">Consultation</option>
              <option value="Lab Test">Lab Test</option>
              <option value="Medicine">Medicine</option>
              <option value="Room Charge">Room Charge</option>
            </select>
          </div>
          <div class="col-md-2">
            <input type="number" class="form-control-custom item-price" placeholder="Price" step="0.01" required oninput="calculateTotals()">
          </div>
          <div class="col-md-2">
            <input type="number" class="form-control-custom item-qty" placeholder="Qty" value="1" min="1" required oninput="calculateTotals()">
          </div>
          <div class="col-md-1 text-end">
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItem(this)">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      </div>
      <button type="button" class="btn btn-sm btn-outline-info rounded-pill mt-2" onclick="addItemRow()">
        <i class="fa-solid fa-plus me-1"></i> Add Line Item
      </button>

      <!-- Financial Calculation Bar -->
      <div class="section-label">Summary & Settlement</div>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="text-secondary small fw-bold mb-1">Payment Method</label>
          <select name="payment_method" class="form-select-custom">
            <option value="Cash">Cash</option>
            <option value="Credit Card">Credit Card</option>
            <option value="Insurance">Insurance</option>
            <option value="UPI">UPI / Online</option>
            <option value="Bank Transfer">Bank Transfer</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="text-secondary small fw-bold mb-1">Status</label>
          <select name="payment_status" class="form-select-custom">
            <option value="Pending">Pending</option>
            <option value="Paid">Paid</option>
            <option value="Partially Paid">Partially Paid</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="text-secondary small fw-bold mb-1">Discount ($)</label>
          <input type="number" id="discountInput" name="discount_amount" class="form-control-custom" value="0.00" step="0.01" oninput="calculateTotals()">
        </div>
        <div class="col-md-2">
          <label class="text-secondary small fw-bold mb-1">Tax (%)</label>
          <input type="number" id="taxInput" name="tax_rate" class="form-control-custom" value="5.00" step="0.5" oninput="calculateTotals()">
        </div>
      </div>

      <!-- Real-Time Total Box -->
      <div class="p-3 mt-4 rounded-3 text-end" style="background: rgba(255,255,255,0.03); border: 1px solid var(--card-border);">
        <span class="text-secondary small me-3">Subtotal: <strong id="subtotalDisplay" class="text-white">$0.00</strong></span>
        <span class="text-secondary small me-3">Tax: <strong id="taxDisplay" class="text-white">$0.00</strong></span>
        <span class="fs-5 fw-bold text-white">Grand Total: <span id="totalDisplay" class="text-info">$0.00</span></span>
      </div>

      <button type="submit" class="btn-submit">
        <i class="fa-solid fa-file-invoice me-2"></i> Save & Generate Invoice
      </button>
    </form>
  </div>
</div>

<script>
  function syncDoctorName() {
    const sel = document.getElementById('doctorSelect');
    document.getElementById('doctorNameInput').value = sel.options[sel.selectedIndex].dataset.name || '';
  }

  function addItemRow() {
    const container = document.getElementById('itemsContainer');
    const row = document.createElement('div');
    row.className = 'row g-2 align-items-center mb-2 item-row';
    row.innerHTML = `
      <div class="col-md-4"><input type="text" class="form-control-custom item-desc" placeholder="Service / Procedure" required></div>
      <div class="col-md-3">
        <select class="form-select-custom item-type">
          <option value="Treatment">Treatment</option>
          <option value="Consultation">Consultation</option>
          <option value="Lab Test">Lab Test</option>
          <option value="Medicine">Medicine</option>
          <option value="Room Charge">Room Charge</option>
        </select>
      </div>
      <div class="col-md-2"><input type="number" class="form-control-custom item-price" placeholder="Price" step="0.01" required oninput="calculateTotals()"></div>
      <div class="col-md-2"><input type="number" class="form-control-custom item-qty" placeholder="Qty" value="1" min="1" required oninput="calculateTotals()"></div>
      <div class="col-md-1 text-end"><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItem(this)"><i class="fa-solid fa-trash"></i></button></div>
    `;
    container.appendChild(row);
  }

  function removeItem(btn) {
    if (document.querySelectorAll('.item-row').length > 1) {
      btn.closest('.item-row').remove();
      calculateTotals();
    }
  }

  function calculateTotals() {
    let subtotal = 0;
    document.querySelectorAll('.item-row').forEach(row => {
      const price = parseFloat(row.querySelector('.item-price').value) || 0;
      const qty = parseInt(row.querySelector('.item-qty').value) || 1;
      subtotal += (price * qty);
    });

    const discount = parseFloat(document.getElementById('discountInput').value) || 0;
    const taxRate = parseFloat(document.getElementById('taxInput').value) || 0;
    const taxable = Math.max(0, subtotal - discount);
    const tax = (taxable * taxRate) / 100;
    const total = taxable + tax;

    document.getElementById('subtotalDisplay').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('taxDisplay').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('totalDisplay').textContent = `$${total.toFixed(2)}`;
  }

  document.getElementById('invoiceForm').addEventListener('submit', function (e) {
    const items = [];
    document.querySelectorAll('.item-row').forEach(row => {
      items.push({
        description: row.querySelector('.item-desc').value,
        type: row.querySelector('.item-type').value,
        unit_price: row.querySelector('.item-price').value,
        quantity: row.querySelector('.item-qty').value
      });
    });
    document.getElementById('itemsPayload').value = JSON.stringify(items);
  });
</script>