<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ward & Bed Management | WellCure Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(17, 24, 39, 0.75);
      --border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --available: #10b981;
      --occupied: #ef4444;
      --maintenance: #f59e0b;
      --primary: #6366f1;
    }
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Plus Jakarta Sans', sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 30px; min-height: 100vh; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .header h1 { font-size: 24px; font-weight: 700; }
    .back-btn { color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 14px; }
    .back-btn:hover { color: var(--text); }
    
    /* Metrics Row */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 30px; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 20px; backdrop-filter: blur(16px); }
    .stat-card h3 { font-size: 13px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }
    .stat-card p { font-size: 28px; font-weight: 800; }
    .text-avail { color: var(--available); }
    .text-occ { color: var(--occupied); }
    .text-maint { color: var(--maintenance); }

    /* Beds Grid */
    .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
    .bed-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 20px; position: relative; }
    .bed-card.Available { border-top: 4px solid var(--available); }
    .bed-card.Occupied { border-top: 4px solid var(--occupied); }
    .bed-card.Maintenance { border-top: 4px solid var(--maintenance); }

    .bed-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .bed-num { font-size: 18px; font-weight: 700; }
    .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
    .badge-Available { background: rgba(16, 185, 129, 0.15); color: var(--available); }
    .badge-Occupied { background: rgba(239, 68, 68, 0.15); color: var(--occupied); }
    .badge-Maintenance { background: rgba(245, 158, 11, 0.15); color: var(--maintenance); }

    .bed-info { font-size: 13px; color: var(--text-muted); margin-bottom: 16px; display: flex; flex-direction: column; gap: 4px; }
    .bed-info strong { color: var(--text); }
    
    .bed-actions form { display: flex; gap: 8px; flex-direction: column; }
    .bed-actions input { background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: #fff; padding: 8px 12px; border-radius: 8px; font-size: 13px; outline: none; }
    .btn { border: none; border-radius: 8px; padding: 9px 12px; font-size: 13px; font-weight: 600; cursor: pointer; text-align: center; }
    .btn-alloc { background: var(--primary); color: white; }
    .btn-discharge { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .btn-discharge:hover { background: #ef4444; color: white; }
    .btn-clean { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .btn-clean:hover { background: #f59e0b; color: white; }

    /* Modal styling */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(6px);
      justify-content: center;
      align-items: center;
      z-index: 999;
    }
    .modal-box {
      background: #111827;
      border: 1px solid var(--border);
      border-radius: 18px;
      width: 420px;
      padding: 28px;
      color: #fff;
    }
  </style>
</head>
<body>

  <div class="header">
    <div>
      <a href="/admin/l_login" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
      <h1 style="margin-top: 6px;">Hospital Ward & Bed Management</h1>
    </div>
    <button onclick="document.getElementById('addBedModal').style.display='flex'" 
            style="background: #6366f1; color: white; border: none; padding: 10px 18px; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
      <i class="fa-solid fa-plus"></i> Add New Bed
    </button>
  </div>

  <!-- Metric Counters -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Total Capacity</h3>
      <p><%= typeof stats !== 'undefined' ? stats.total_beds : 0 %></p>
    </div>
    <div class="stat-card">
      <h3>Available Beds</h3>
      <p class="text-avail"><%= typeof stats !== 'undefined' ? stats.available_beds : 0 %></p>
    </div>
    <div class="stat-card">
      <h3>Occupied Beds</h3>
      <p class="text-occ"><%= typeof stats !== 'undefined' ? stats.occupied_beds : 0 %></p>
    </div>
    <div class="stat-card">
      <h3>Maintenance / Cleaning</h3>
      <p class="text-maint"><%= typeof stats !== 'undefined' ? stats.maintenance_beds : 0 %></p>
    </div>
  </div>

  <!-- Real-time Bed Cards -->
  <div class="grid-container">
    <% if (typeof beds !== 'undefined' && beds.length > 0) { %>
      <% beds.forEach(bed => { %>
        <div class="bed-card <%= bed.status %>">
          <div class="bed-top">
            <span class="bed-num"><i class="fa-solid fa-bed"></i> <%= bed.bed_number %></span>
            <span class="badge badge-<%= bed.status %>"><%= bed.status %></span>
          </div>

          <div class="bed-info">
            <div>Ward: <strong><%= bed.ward_type %></strong></div>
            <div>Daily Rate: <strong>$<%= parseFloat(bed.daily_charge || 0).toFixed(2) %>/day</strong></div>
            <% if (bed.status === 'Occupied') { %>
              <div>Patient: <strong><%= bed.patient_name %></strong></div>
              <div>Admitted: <strong><%= bed.admitted_date ? new Date(bed.admitted_date).toLocaleDateString() : 'N/A' %></strong></div>
            <% } %>
          </div>

          <div class="bed-actions">
            <% if (bed.status === 'Available') { %>
              <form action="/admin/beds/allocate" method="POST">
                <input type="hidden" name="bed_id" value="<%= bed.bed_id %>">
                <input type="text" name="patient_name" placeholder="Patient Full Name" required>
                <button type="submit" class="btn btn-alloc">Assign Patient</button>
              </form>
              <form action="/admin/beds/maintenance" method="POST" style="margin-top: 6px;">
                <input type="hidden" name="bed_id" value="<%= bed.bed_id %>">
                <input type="hidden" name="status" value="Maintenance">
                <button type="submit" class="btn btn-clean">Send to Cleaning</button>
              </form>
            <% } else if (bed.status === 'Occupied') { %>
              <form action="/admin/beds/discharge" method="POST">
                <input type="hidden" name="bed_id" value="<%= bed.bed_id %>">
                <button type="submit" class="btn btn-discharge">Process Discharge</button>
              </form>
            <% } else { %>
              <form action="/admin/beds/maintenance" method="POST">
                <input type="hidden" name="bed_id" value="<%= bed.bed_id %>">
                <input type="hidden" name="status" value="Available">
                <button type="submit" class="btn btn-alloc" style="background: var(--maintenance);">Set to Available</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p style="color: var(--text-muted); grid-column: 1 / -1;">No beds registered yet. Click "Add New Bed" to begin.</p>
    <% } %>
  </div>

  <!-- Add Bed Modal -->
  <div id="addBedModal" class="modal-overlay">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
        <h3 style="font-size:18px;">Add Hospital Bed</h3>
        <span onclick="document.getElementById('addBedModal').style.display='none'" style="cursor:pointer; font-size:20px; color:#94a3b8;">&times;</span>
      </div>
      
      <form action="/admin/beds/add" method="POST" style="display:flex; flex-direction:column; gap:14px;">
        <div>
          <label style="font-size:12px; color:#94a3b8; display:block; margin-bottom:4px;">Bed Number</label>
          <input type="text" name="bed_number" placeholder="e.g. ICU-103, GEN-204" required 
                 style="width:100%; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,0.1); background:#090d16; color:#fff;">
        </div>

        <div>
          <label style="font-size:12px; color:#94a3b8; display:block; margin-bottom:4px;">Ward Category</label>
          <select name="ward_type" style="width:100%; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,0.1); background:#090d16; color:#fff;">
            <option value="General">General</option>
            <option value="ICU">ICU</option>
            <option value="Emergency">Emergency</option>
            <option value="Pediatric">Pediatric</option>
          </select>
        </div>

        <div>
          <label style="font-size:12px; color:#94a3b8; display:block; margin-bottom:4px;">Daily Charge ($)</label>
          <input type="number" step="0.01" name="daily_charge" placeholder="800.00" required 
                 style="width:100%; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,0.1); background:#090d16; color:#fff;">
        </div>

        <div>
          <label style="font-size:12px; color:#94a3b8; display:block; margin-bottom:4px;">Initial Status</label>
          <select name="status" style="width:100%; padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,0.1); background:#090d16; color:#fff;">
            <option value="Available">Available</option>
            <option value="Maintenance">Maintenance</option>
          </select>
        </div>

        <button type="submit" style="background:#6366f1; color:white; border:none; padding:12px; border-radius:8px; font-weight:700; margin-top:8px; cursor:pointer;">
          Create Bed
        </button>
      </form>
    </div>
  </div>

</body>
</html>