<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Medical Gas Pipeline & Oxygen Bank | WellCure Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(17, 24, 39, 0.75);
      --border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #6366f1;
      --success: #10b981;
      --info: #38bdf8;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Plus Jakarta Sans', sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 30px; min-height: 100vh; }

    .top-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .back-link { color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 6px; }
    .back-link:hover { color: #fff; }

    /* Top Stats Grid */
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 30px; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 20px; backdrop-filter: blur(12px); }
    .stat-card h3 { font-size: 13px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }
    .stat-card p { font-size: 28px; font-weight: 800; }

    /* Pipeline Cards Grid */
    .pipeline-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 30px; }
    .manifold-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 20px; backdrop-filter: blur(12px); position: relative; }
    .manifold-card.alert { border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.08); }
    
    .status-badge { font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 12px; }
    .stat-optimal { background: rgba(16, 185, 129, 0.15); color: var(--success); }
    .stat-crit { background: rgba(239, 68, 68, 0.2); color: var(--danger); animation: pulse 1.5s infinite; border: 1px solid rgba(239, 68, 68, 0.4); }
    .stat-warn { background: rgba(245, 158, 11, 0.15); color: var(--warning); }

    @keyframes pulse { 0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; } }

    /* Table Container */
    .table-container { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 24px; overflow-x: auto; backdrop-filter: blur(12px); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
    th { padding: 14px 16px; color: var(--text-muted); font-size: 12px; text-transform: uppercase; border-bottom: 1px solid var(--border); }
    td { padding: 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }

    .btn { padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-action { background: rgba(255, 255, 255, 0.08); color: #cbd5e1; border: 1px solid var(--border); padding: 5px 8px; font-size: 11px; border-radius: 6px; cursor: pointer; }
    .btn-delete { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    /* Modal Form Elements */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); justify-content: center; align-items: center; z-index: 1000; }
    .modal-box { background: #111827; border: 1px solid var(--border); border-radius: 18px; width: 480px; max-height: 90vh; overflow-y: auto; padding: 26px; color: #fff; }
    .form-group { margin-bottom: 12px; display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 12px; color: var(--text-muted); }
    .form-group input, .form-group select { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: #090d16; color: #fff; font-size: 13px; outline: none; }
  </style>
</head>
<body>

  <div class="top-header">
    <div>
      <a href="/admin/l_login" class="back-link"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
      <h1 style="font-size: 24px; font-weight: 800;">Medical Gas (MGPS) & Oxygen Bank</h1>
    </div>
    <button class="btn btn-primary" onclick="document.getElementById('cylinderModal').style.display='flex'">
      <i class="fa-solid fa-plus"></i> Add Gas Cylinder
    </button>
  </div>

  <!-- Dynamic Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <h3>Active Pipeline Alerts</h3>
      <p style="color: <%= stats.active_gas_alerts > 0 ? 'var(--danger)' : 'var(--success)' %>;">
        <i class="fa-solid fa-bell"></i> <%= stats.active_gas_alerts %> Line Drops
      </p>
    </div>
    <div class="stat-card">
      <h3>Oxygen Cylinders Ready</h3>
      <p style="color: var(--success);"><%= stats.full_cylinders %></p>
    </div>
    <div class="stat-card">
      <h3>Depleted / Needs Refill</h3>
      <p style="color: var(--danger);"><%= stats.empty_cylinders %></p>
    </div>
    <div class="stat-card">
      <h3>Total Cylinder Bank</h3>
      <p><%= stats.total_cylinders %></p>
    </div>
  </div>

  <!-- Pipeline Live Manifold Monitors -->
  <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 16px;"><i class="fa-solid fa-gauge-high" style="color: var(--info);"></i> Central Pipeline Manifold Pressure</h2>
  <div class="pipeline-grid">
    <% lines.forEach(l => { %>
      <div class="manifold-card <%= l.status !== 'Optimal' ? 'alert' : '' %>">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
          <div>
            <strong><%= l.gas_type %></strong>
            <div style="font-size: 12px; color: var(--text-muted);"><%= l.line_zone %></div>
          </div>
          <span class="status-badge <%= l.status === 'Optimal' ? 'stat-optimal' : (l.status === 'Critical Drop' ? 'stat-crit' : 'stat-warn') %>">
            <%= l.status %>
          </span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 12px;">
          <div style="font-size: 28px; font-weight: 800; color: #fff;">
            <%= parseFloat(l.current_pressure_bar).toFixed(2) %> <span style="font-size: 14px; color: var(--text-muted); font-weight: 500;">Bar</span>
          </div>
          <small style="color: var(--text-muted);">Threshold: <%= l.alarm_threshold_bar %> Bar</small>
        </div>

        <form action="/admin/mgps_oxygen/update-line-pressure" method="POST" style="margin-top: 12px; display: flex; gap: 6px;">
          <input type="hidden" name="line_id" value="<%= l.line_id %>">
          <input type="number" step="0.05" name="current_pressure_bar" value="<%= l.current_pressure_bar %>" class="btn-action" style="flex:1;">
          <button type="submit" class="btn-action" style="background: #6366f1; color: #fff;">Log Bar</button>
        </form>
      </div>
    <% }) %>
  </div>

  <!-- Physical Cylinder Bank Table -->
  <h2 style="font-size: 18px; font-weight: 700; margin: 24px 0 16px 0;"><i class="fa-solid fa-bottle-droplet" style="color: var(--primary);"></i> Physical Oxygen Cylinder Bank</h2>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Cylinder Barcode & Type</th>
          <th>Ward Allocation</th>
          <th>Pressure (PSI)</th>
          <th>Vendor & Hydro Test</th>
          <th>Fill Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (cylinders && cylinders.length > 0) { %>
          <% cylinders.forEach(c => { %>
            <tr>
              <td>
                <strong><%= c.cylinder_type %></strong>
                <div style="font-size: 12px; color: #818cf8; font-family: monospace;"><%= c.cylinder_barcode %></div>
              </td>
              <td><strong><%= c.assigned_ward %></strong></td>
              <td>
                <span style="font-weight: 800; color: <%= c.pressure_psi <= 500 ? 'var(--danger)' : 'var(--success)' %>;">
                  <%= c.pressure_psi %> PSI
                </span>
              </td>
              <td style="font-size: 13px;">
                <div><%= c.supplier_vendor %></div>
                <small style="color: var(--text-muted);">Hydro: <%= new Date(c.last_hydro_test).toISOString().slice(0, 10) %></small>
              </td>
              <td>
                <form action="/admin/mgps_oxygen/update-cylinder-status" method="POST" style="display:flex; gap: 6px;">
                  <input type="hidden" name="cylinder_id" value="<%= c.cylinder_id %>">
                  <select name="fill_status" class="btn-action">
                    <option value="Full (Ready)" <%= c.fill_status === 'Full (Ready)' ? 'selected' : '' %>>Full (Ready)</option>
                    <option value="In Use" <%= c.fill_status === 'In Use' ? 'selected' : '' %>>In Use</option>
                    <option value="Depleted / Empty" <%= c.fill_status === 'Depleted / Empty' ? 'selected' : '' %>>Depleted / Empty</option>
                    <option value="Sent for Refill" <%= c.fill_status === 'Sent for Refill' ? 'selected' : '' %>>Sent for Refill</option>
                  </select>
                  <input type="number" name="pressure_psi" value="<%= c.pressure_psi %>" placeholder="PSI" class="btn-action" style="width: 70px;">
                  <button type="submit" class="btn-action" style="background:#10b981; color:#000; font-weight:bold;">Save</button>
                </form>
              </td>
              <td>
                <a href="/admin/mgps_oxygen/delete-cylinder/<%= c.cylinder_id %>" class="btn btn-delete" onclick="return confirm('Deregister cylinder from inventory?')">
                  <i class="fa-solid fa-trash"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 30px;">
              No oxygen cylinders registered. Click "Add Gas Cylinder" to populate your stock.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Modal: Add New Cylinder -->
  <div id="cylinderModal" class="modal-overlay">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h3 style="font-size:18px;">Register Oxygen Cylinder</h3>
        <span onclick="document.getElementById('cylinderModal').style.display='none'" style="cursor:pointer; font-size:20px; color:var(--text-muted);">&times;</span>
      </div>

      <form action="/admin/mgps_oxygen/save-cylinder" method="POST">
        <div class="form-group">
          <label>Cylinder Classification</label>
          <select name="cylinder_type" required>
            <option value="D-Type Jumbo (46.7L)">D-Type Jumbo (46.7L - High Flow)</option>
            <option value="B-Type Ward Portable (10.2L)">B-Type Ward Portable (10.2L - Stretcher/Ambulance)</option>
            <option value="Liquid Cryogenic Tanker Refill">Liquid Cryogenic Tanker Refill</option>
          </select>
        </div>

        <div class="form-group">
          <label>Assigned Department / Location</label>
          <select name="assigned_ward" required>
            <% departments.forEach(d => { %>
              <option value="<%= d.department_name %>"><%= d.department_name %></option>
            <% }) %>
            <option value="Central Manifold Room">Central Manifold Room</option>
            <option value="ICU Emergency Backup">ICU Emergency Backup</option>
            <option value="Ambulance Fleet">Ambulance Fleet</option>
            <option value="Emergency Trauma Bay">Emergency Trauma Bay</option>
          </select>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Manifold Pressure (PSI)</label>
            <input type="number" name="pressure_psi" value="2000" required>
          </div>
          <div class="form-group">
            <label>Fill Status</label>
            <select name="fill_status" required>
              <option value="Full (Ready)">Full (Ready)</option>
              <option value="In Use">In Use</option>
              <option value="Depleted / Empty">Depleted / Empty</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <label>Supply Vendor</label>
            <input type="text" name="supplier_vendor" placeholder="e.g. Inox Air Products" required>
          </div>
          <div class="form-group">
            <label>Last Hydrostatic Test</label>
            <input type="date" name="last_hydro_test" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          Register Gas Cylinder
        </button>
      </form>
    </div>
  </div>

</body>
</html>