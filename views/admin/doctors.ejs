<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Medical Specialists | WellCure Admin</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* ========================================================
       1. GLOBAL & SHELL STYLES (MATCHING INDEX / APPOINTMENTS)
       ======================================================== */
    :root {
      --admin-sidebar-width: 270px;
      --admin-topbar-height: 75px;
      --bg-dark: #090d16;
      --card-bg: rgba(18, 24, 38, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --topbar-bg: rgba(13, 17, 28, 0.85);
      --accent-gradient: linear-gradient(135deg, #6366f1, #d946ef);
      --accent-hover: linear-gradient(135deg, #4f46e5, #c026d3);
      --cyan-gradient: linear-gradient(135deg, #06b6d4, #3b82f6);
      --emerald-gradient: linear-gradient(135deg, #10b981, #059669);
      --danger-gradient: linear-gradient(135deg, #ef4444, #f43f5e);
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Sidebar Navigation */
    .app-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--admin-sidebar-width);
      background: rgba(13, 17, 28, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      z-index: 1050;
      transition: transform 0.35s ease;
    }

    .brand-section {
      height: var(--admin-topbar-height);
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      border-bottom: 1px solid var(--card-border);
    }

    .brand-link {
      font-size: 1.45rem;
      font-weight: 800;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sidebar-menu-wrapper {
      flex: 1;
      padding: 1.25rem 1rem;
      overflow-y: auto;
    }

    .nav-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #64748b;
      margin: 1rem 0 0.5rem 0.75rem;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      margin-bottom: 4px;
      color: var(--text-muted);
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .sidebar-link i {
      font-size: 1.05rem;
      width: 22px;
      text-align: center;
      color: #818cf8;
    }

    .sidebar-link:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      transform: translateX(4px);
    }

    .sidebar-link.active {
      background: var(--accent-gradient);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    }

    .sidebar-link.active i {
      color: #fff;
    }

    /* Header / Topbar */
    .app-topbar {
      position: fixed;
      top: 0;
      right: 0;
      left: var(--admin-sidebar-width);
      height: var(--admin-topbar-height);
      background: var(--topbar-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--card-border);
      z-index: 1040;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
    }

    .hospital-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.04);
      padding: 6px 14px;
      border-radius: 50px;
      border: 1px solid var(--card-border);
    }

    .hospital-badge .pulse-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      padding: 6px 14px 6px 8px;
      border-radius: 50px;
      cursor: pointer;
      color: var(--text-main);
    }

    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #818cf8;
    }

    /* Content Viewport */
    .doctors-page-wrapper {
      margin-left: var(--admin-sidebar-width);
      padding-top: calc(var(--admin-topbar-height) + 1.8rem);
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 4rem;
      min-height: 100vh;
      position: relative;
      z-index: 1;
      transition: margin-left 0.35s ease;
    }

    .doctors-content-inner {
      max-width: 1400px;
      margin: 0 auto;
      animation: fadeInPage 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fadeInPage {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Background Spotlight */
    .mouse-glow-canvas {
      position: fixed;
      top: 0;
      left: var(--admin-sidebar-width);
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.12), rgba(217, 70, 239, 0.04), transparent 70%);
      pointer-events: none;
      transform: translate(-50%, -50%);
      z-index: 0;
      transition: opacity 0.3s ease;
    }

    /* ========================================================
       2. DOCTORS PAGE SPECIFIC STYLES
       ======================================================== */
    .glass-panel {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--card-border);
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    .title-gradient {
      font-size: 1.85rem;
      font-weight: 700;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }

    .btn-gradient-primary {
      background: var(--accent-gradient);
      color: #fff !important;
      border: none;
      border-radius: 12px;
      padding: 10px 20px;
      font-weight: 600;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-gradient-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(217, 70, 239, 0.45);
    }

    .btn-gradient-danger {
      background: var(--danger-gradient);
      color: #fff !important;
      border: none;
      border-radius: 12px;
      padding: 10px 18px;
      font-weight: 600;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-gradient-danger:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(239, 68, 68, 0.4);
    }

    .custom-search {
      background: rgba(255, 255, 255, 0.04) !important;
      border: 1px solid var(--card-border) !important;
      border-radius: 12px !important;
      color: #f1f5f9 !important;
      padding: 11px 18px !important;
      font-size: 0.92rem;
    }

    .custom-search:focus {
      background: rgba(255, 255, 255, 0.07) !important;
      border-color: #818cf8 !important;
      box-shadow: 0 0 0 4px rgba(129, 140, 248, 0.18) !important;
    }

    .custom-search::placeholder {
      color: #64748b;
    }

    .table-custom {
      margin-bottom: 0;
      width: 100%;
    }

    .table-custom th {
      background: rgba(255, 255, 255, 0.03) !important;
      color: #94a3b8 !important;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.76rem;
      letter-spacing: 0.8px;
      padding: 15px 14px;
      border-bottom: 1px solid var(--card-border) !important;
      white-space: nowrap;
    }

    .table-custom td {
      padding: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
      background: transparent !important;
      color: #e2e8f0 !important;
      font-size: 0.88rem;
      vertical-align: middle;
      white-space: nowrap;
    }

    .table-custom tbody tr:hover {
      background: rgba(255, 255, 255, 0.04) !important;
    }

    .badge-id {
      background: rgba(99, 102, 241, 0.15);
      color: #a5b4fc;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .badge-pill-custom {
      background: rgba(14, 165, 233, 0.15);
      color: #38bdf8;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 500;
    }

    .contact-item {
      font-size: 0.82rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-row-action {
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.2s ease;
    }

    .btn-row-edit {
      background: rgba(6, 182, 212, 0.15);
      color: #22d3ee !important;
      border: 1px solid rgba(6, 182, 212, 0.3);
    }

    .btn-row-edit:hover {
      background: var(--cyan-gradient);
      color: #fff !important;
      transform: translateY(-2px);
    }

    .btn-row-delete {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171 !important;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-row-delete:hover {
      background: var(--danger-gradient);
      color: #fff !important;
      transform: translateY(-2px);
    }

    .pagination .page-link {
      background: rgba(255, 255, 255, 0.04) !important;
      border: 1px solid var(--card-border) !important;
      color: #cbd5e1 !important;
      border-radius: 10px !important;
      padding: 8px 14px;
      font-size: 0.88rem;
      font-weight: 600;
    }

    .pagination .page-item.active .page-link {
      background: var(--accent-gradient) !important;
      border-color: transparent !important;
      color: #fff !important;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
    }

    /* Mobile / Tablet Adjustments */
    @media (max-width: 991.98px) {
      .app-sidebar { transform: translateX(-100%); }
      .app-sidebar.show { transform: translateX(0); }
      .app-topbar { left: 0; }
      .hospital-badge { display: none; }
      .doctors-page-wrapper {
        margin-left: 0 !important;
        padding-top: calc(var(--admin-topbar-height) + 1rem);
        padding-left: 1rem;
        padding-right: 1rem;
      }
      .mouse-glow-canvas { left: 0; }
    }
  </style>
</head>
<body>

  <!-- Shared Sidebar Partial (Active: doctors) -->
  <%- include("../partials/sidebar", { activePage: 'doctors' }) %>

  <!-- Shared Topbar Partial -->
  <%- include("../partials/navbar") %>

  <!-- Mouse Glow Spotlight -->
  <div class="mouse-glow-canvas" id="mouseGlowLayer"></div>

  <!-- Content Viewport -->
  <main class="doctors-page-wrapper">
    <div class="doctors-content-inner">

      <!-- Header Section -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <h1 class="title-gradient mb-1">
            <i class="fa-solid fa-user-doctor me-2"></i>Medical Specialists
          </h1>
          <p class="text-secondary mb-0 small">Active clinicians, specialties, contacts, and branch assignments.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="/admin/doctors/download-pdf" class="btn-gradient-danger">
            <i class="fa-solid fa-file-pdf"></i> Download PDF
          </a>
          <a href="/admin/create_doctors" class="btn-gradient-primary">
            <i class="fa-solid fa-plus"></i> Add Doctor
          </a>
        </div>
      </div>

      <!-- Search Card -->
      <div class="glass-panel p-3 mb-4">
        <div class="input-group">
          <span class="input-group-text bg-transparent border-0 text-secondary ps-3">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input 
            type="text" 
            id="doctorSearchInput" 
            class="form-control custom-search" 
            placeholder="Filter doctors by name, qualification, email, or city..." 
            onkeyup="filterDoctors()"
          />
        </div>
      </div>

      <!-- Table Panel -->
      <div class="glass-panel overflow-hidden">
        <div class="table-responsive">
          <table class="table table-custom align-middle">
            <thead>
              <tr>
                <th scope="col" style="width: 70px;">ID</th>
                <th scope="col">Doctor</th>
                <th scope="col">Age</th>
                <th scope="col">Contact</th>
                <th scope="col">Status</th>
                <th scope="col">Qualification</th>
                <th scope="col">Location</th>
                <th scope="col" class="text-end" style="width: 170px;">Actions</th>
              </tr>
            </thead>
            <tbody id="doctorTableBody">
              <% if (typeof doctors_info !== 'undefined' && doctors_info.length > 0) { %>
                <% doctors_info.forEach(function(doctor) { %>
                  <tr>
                    <td><span class="badge-id">#<%= doctor.doctor_id %></span></td>
                    <td>
                      <span class="fw-semibold text-white">
                        Dr. <%= doctor.first_name %> <%= doctor.last_name %>
                      </span>
                    </td>
                    <td><%= doctor.age %> yrs</td>
                    <td>
                      <div class="contact-item">
                        <i class="fa-regular fa-envelope text-secondary"></i> <%= doctor.email %>
                      </div>
                      <div class="contact-item mt-1">
                        <i class="fa-solid fa-phone text-secondary"></i> <%= doctor.mobile %>
                      </div>
                    </td>
                    <td>
                      <span class="badge-pill-custom"><%= doctor.marital_status %></span>
                    </td>
                    <td class="fw-medium text-info"><%= doctor.qualification %></td>
                    <td>
                      <span class="text-white"><%= doctor.city %></span>, 
                      <small class="text-secondary"><%= doctor.state %>, <%= doctor.country %></small>
                    </td>
                    <td class="text-end">
                      <a href="/admin/update_doctor/<%= doctor.doctor_id %>" class="btn-row-action btn-row-edit me-1">
                        <i class="fa-regular fa-pen-to-square"></i> Edit
                      </a>
                      <a href="/admin/delete_doctor/<%= doctor.doctor_id %>" 
                         class="btn-row-action btn-row-delete" 
                         onclick="return confirm('Are you sure you want to delete Dr. <%= doctor.first_name %> <%= doctor.last_name %>?')">
                        <i class="fa-regular fa-trash-can"></i> Delete
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-5 text-secondary">
                    <i class="fa-solid fa-user-slash fs-2 d-block mb-2 opacity-50"></i>
                    No doctors found.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (typeof pages !== 'undefined' && pages > 1) { %>
          <div class="p-3 border-top" style="border-color: var(--card-border) !important;">
            <nav aria-label="Doctor list pagination">
              <ul class="pagination justify-content-center mb-0" style="gap: 6px;">
                <% for (let i = 1; i <= pages; i++) { %>
                  <li class="page-item <%= (typeof current !== 'undefined' && i === current) ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>

    </div>
  </main>

  <!-- Client-Side Scripts -->
  <script>
    // Mouse Spotlight Movement
    const glow = document.getElementById('mouseGlowLayer');
    if (glow) {
      window.addEventListener('mousemove', (e) => {
        glow.style.left = `${e.clientX}px`;
        glow.style.top = `${e.clientY}px`;
      });
    }

    // Instant Client Filter
    function filterDoctors() {
      const query = document.getElementById("doctorSearchInput").value.toLowerCase();
      const rows = document.querySelectorAll("#doctorTableBody tr");

      rows.forEach(row => {
        const match = row.textContent.toLowerCase().includes(query);
        row.style.display = match ? "" : "none";
      });
    }
  </script>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>