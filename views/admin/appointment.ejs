<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Appointments Directory | WellCure Admin</title>

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --admin-sidebar-width: 270px;
      --admin-topbar-height: 75px;
      --bg-dark: #090d16;
      --card-bg: rgba(18, 24, 38, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --topbar-bg: rgba(13, 17, 28, 0.85);
      --accent-gradient: linear-gradient(135deg, #6366f1, #d946ef);
      --cyan-gradient: linear-gradient(135deg, #06b6d4, #3b82f6);
      --emerald-gradient: linear-gradient(135deg, #10b981, #059669);
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;

      /* Table Card Specifics */
      --primary: #2563eb;
      --primary-subtle: #eff6ff;
      --surface: #ffffff;
      --border: #e2e8f0;
      --badge-dept-bg: #f0fdf4;
      --badge-dept-text: #15803d;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    .app-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--admin-sidebar-width);
      background: rgba(13, 17, 28, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-right: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      z-index: 1050;
      transition: transform 0.35s ease;
    }

    .brand-section {
      height: var(--admin-topbar-height);
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      border-bottom: 1px solid var(--card-border);
    }

    .brand-link {
      font-size: 1.45rem;
      font-weight: 800;
      background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sidebar-menu-wrapper {
      flex: 1;
      padding: 1.25rem 1rem;
      overflow-y: auto;
    }

    .nav-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #64748b;
      margin: 1rem 0 0.5rem 0.75rem;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      margin-bottom: 4px;
      color: var(--text-muted);
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .sidebar-link i {
      font-size: 1.05rem;
      width: 22px;
      text-align: center;
      color: #818cf8;
    }

    .sidebar-link:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      transform: translateX(4px);
    }

    .sidebar-link.active {
      background: var(--accent-gradient);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    }

    .sidebar-link.active i {
      color: #fff;
    }

    .app-topbar {
      position: fixed;
      top: 0;
      right: 0;
      left: var(--admin-sidebar-width);
      height: var(--admin-topbar-height);
      background: var(--topbar-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--card-border);
      z-index: 1040;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
    }

    .hospital-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.04);
      padding: 6px 14px;
      border-radius: 50px;
      border: 1px solid var(--card-border);
    }

    .hospital-badge .pulse-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      padding: 6px 14px 6px 8px;
      border-radius: 50px;
      cursor: pointer;
      color: var(--text-main);
    }

    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #818cf8;
    }

    .app-main-viewport {
      position: relative;
      z-index: 1;
      margin-left: var(--admin-sidebar-width);
      padding-top: calc(var(--admin-topbar-height) + 1.8rem);
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 3rem;
      min-height: 100vh;
    }

    .main-card {
      background: var(--surface);
      border-radius: 16px;
      border: 1px solid var(--border);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.35);
      overflow: hidden;
      width: 100%;
      color: #0f172a;
    }

    .card-topbar {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      background: #ffffff;
    }

    .search-wrapper {
      position: relative;
      flex-grow: 1;
      max-width: 360px;
    }

    .search-wrapper i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 0.9rem;
    }

    .search-input {
      padding-left: 2.4rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      background-color: #f8fafc;
      font-size: 0.9rem;
      width: 100%;
    }

    .search-input:focus {
      background-color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .custom-table {
      margin-bottom: 0;
      width: 100%;
    }

    .custom-table thead th {
      background-color: #f8fafc;
      color: #64748b;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
      padding: 0.9rem 1rem;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    .custom-table tbody td {
      padding: 0.9rem 1rem;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
      font-size: 0.88rem;
    }

    .custom-table tbody tr:hover {
      background-color: #f8fafc;
    }

    .badge-doctor {
      background-color: var(--primary-subtle);
      color: var(--primary);
      font-weight: 600;
      font-size: 0.8rem;
      padding: 5px 10px;
      border-radius: 8px;
      display: inline-block;
      white-space: nowrap;
    }

    .badge-dept {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--badge-dept-text);
      background: var(--badge-dept-bg);
      padding: 2px 8px;
      border-radius: 6px;
      display: inline-block;
    }

    .action-btn {
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      font-size: 0.85rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .action-edit {
      color: var(--primary);
      background: var(--primary-subtle);
    }

    .action-edit:hover {
      background: var(--primary);
      color: #fff;
    }

    .action-delete {
      color: #dc2626;
      background: #fef2f2;
    }

    .action-delete:hover {
      background: #dc2626;
      color: #fff;
    }

    @media (max-width: 991.98px) {
      .app-sidebar { transform: translateX(-100%); }
      .app-sidebar.show { transform: translateX(0); }
      .app-topbar { left: 0; }
      .app-main-viewport { margin-left: 0; padding-left: 1rem; padding-right: 1rem; }
      .hospital-badge { display: none; }
      .desktop-table-view { display: none !important; }
      .mobile-card-view { display: block !important; }
      .search-wrapper { max-width: 100%; }
    }

    @media (min-width: 992px) {
      .desktop-table-view { display: block !important; }
      .mobile-card-view { display: none !important; }
    }

    .mobile-item-card {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      margin-bottom: 0.85rem;
    }

    .mobile-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      padding: 0.35rem 0;
      border-bottom: 1px dashed var(--border);
    }

    .pagination .page-link {
      color: #0f172a;
      border: 1px solid var(--border);
      margin: 0 2px;
      border-radius: 8px;
      font-weight: 500;
      font-size: 0.85rem;
      padding: 5px 12px;
    }

    .pagination .page-item.active .page-link {
      background-color: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- Sidebar Partial -->
  <%- include("../partials/sidebar", { activePage: 'appointment' }) %>

  <!-- Topbar Partial -->
  <%- include("../partials/navbar") %>

  <!-- Main Viewport -->
  <main class="app-main-viewport">
    <div class="main-card">
      
      <!-- Top Action Bar -->
      <div class="card-topbar d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-3">
        <div>
          <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-calendar2-check text-primary"></i> Patient Appointments
          </h4>
          <span class="text-muted small">Manage upcoming consultations and patient records</span>
        </div>

        <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
          <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" onkeyup="filterAppointments()" class="form-control search-input" placeholder="Search patient, doctor, contact...">
          </div>

          <div class="d-flex gap-2">
            <a href="/admin/email_send" class="btn btn-outline-primary rounded-3 px-3 fw-semibold flex-fill text-nowrap">
              <i class="bi bi-envelope me-1"></i> Send Email
            </a>
            <a href="/admin/appointment/download-pdf" class="btn btn-danger rounded-3 px-3 fw-semibold flex-fill text-nowrap">
              <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
            </a>
          </div>
        </div>
      </div>

      <!-- Desktop Table View -->
      <div class="table-responsive desktop-table-view">
        <table class="table custom-table" id="desktopTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Patient</th>
              <th>Contact Details</th>
              <th>Department</th>
              <th>Assigned Doctor</th>
              <th>Schedule</th>
              <th>Reason</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof details !== 'undefined' && details && details.length > 0) { %>
              <% for (var i = 0; i < details.length; i++) { %>
                <tr class="appointment-record">
                  <td class="fw-semibold text-secondary">#<%= details[i].appointment_id %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= details[i].patient_name %></div>
                    <span class="text-muted small">Gender: <%= details[i].gender || 'N/A' %></span>
                  </td>
                  <td>
                    <div><i class="bi bi-telephone text-muted me-1"></i> <%= details[i].contact_number %></div>
                    <% if (details[i].email) { %>
                      <div class="text-muted small"><i class="bi bi-envelope text-muted me-1"></i> <%= details[i].email %></div>
                    <% } else { %>
                      <div class="text-muted small"><em>No email provided</em></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge-dept"><%= details[i].department || 'General' %></span>
                  </td>
                  <td>
                    <span class="badge-doctor">
                      <i class="bi bi-person-badge me-1"></i><%= details[i].doctor || 'General Specialist' %>
                    </span>
                  </td>
                  <td>
                    <div class="fw-semibold">
                      <%= details[i].appointment_date ? new Date(details[i].appointment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %>
                    </div>
                    <div class="text-muted small">
                      <i class="bi bi-clock me-1"></i><%= details[i].appointment_time || '10:00 AM' %>
                    </div>
                  </td>
                  <td>
                    <span class="d-inline-block text-truncate" style="max-width: 170px;" title="<%= details[i].reason || 'None' %>">
                      <%= details[i].reason || '—' %>
                    </span>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-1">
                      <a href="/admin/update_patient/<%= details[i].appointment_id %>" class="action-btn action-edit" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                      </a>
                      <a href="javascript:void(0)" class="action-btn action-delete" onclick="confirmDelete('<%= details[i].appointment_id %>')" title="Delete">
                        <i class="bi bi-trash3"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% } %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  <i class="bi bi-calendar-x fs-2 d-block mb-2 opacity-50"></i>
                  No appointments found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Mobile/Tablet Card Stack View -->
      <div class="mobile-card-view p-3">
        <% if (typeof details !== 'undefined' && details && details.length > 0) { %>
          <% for (var i = 0; i < details.length; i++) { %>
            <div class="mobile-item-card appointment-record">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold text-dark fs-6"><%= details[i].patient_name %></span>
                <span class="badge-doctor">#<%= details[i].appointment_id %></span>
              </div>

              <div class="mobile-meta-row">
                <span class="text-muted">Department</span>
                <span class="badge-dept"><%= details[i].department || 'General' %></span>
              </div>

              <div class="mobile-meta-row">
                <span class="text-muted">Doctor</span>
                <span class="fw-semibold text-primary"><%= details[i].doctor || 'General Specialist' %></span>
              </div>

              <div class="mobile-meta-row">
                <span class="text-muted">Schedule</span>
                <span>
                  <%= details[i].appointment_date ? new Date(details[i].appointment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %> &bull; <%= details[i].appointment_time || '10:00 AM' %>
                </span>
              </div>

              <div class="mobile-meta-row">
                <span class="text-muted">Phone</span>
                <span><i class="bi bi-telephone text-muted me-1"></i><%= details[i].contact_number %></span>
              </div>

              <div class="mobile-meta-row">
                <span class="text-muted">Email</span>
                <span class="text-muted"><%= details[i].email || '—' %></span>
              </div>

              <div class="mobile-meta-row">
                <span class="text-muted">Reason</span>
                <span class="text-truncate text-end" style="max-width: 60%;"><%= details[i].reason || '—' %></span>
              </div>

              <div class="d-flex justify-content-end align-items-center pt-3 mt-2 border-top">
                <div class="d-flex gap-2">
                  <a href="/admin/update_patient/<%= details[i].appointment_id %>" class="btn btn-sm btn-outline-primary px-3 rounded-3">
                    <i class="bi bi-pencil me-1"></i> Edit
                  </a>
                  <button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-3" onclick="confirmDelete('<%= details[i].appointment_id %>')">
                    <i class="bi bi-trash me-1"></i> Delete
                  </button>
                </div>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-calendar-x fs-2 d-block mb-2 opacity-50"></i>
            No appointments found.
          </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <% if (typeof pages !== 'undefined' && pages > 1) { %>
        <div class="p-3 border-top d-flex justify-content-center">
          <nav aria-label="Appointments Navigation">
            <ul class="pagination mb-0 flex-wrap justify-content-center">
              <% for (let i = 1; i <= pages; i++) { %>
                <li class="page-item <%= (i === current) ? 'active' : '' %>">
                  <a class="page-link shadow-none" href="?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        </div>
      <% } %>

    </div>
  </main>

  <!-- Delete Modal -->
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-body text-center p-4">
          <i class="bi bi-exclamation-circle text-danger display-5 mb-2 d-block"></i>
          <h6 class="fw-bold mb-1 text-dark">Delete Appointment?</h6>
          <p class="text-muted small mb-3">This record will be permanently deleted.</p>
          <div class="d-flex justify-content-center gap-2">
            <button type="button" class="btn btn-sm btn-light rounded-3 px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
            <a id="confirmDeleteBtn" href="#" class="btn btn-sm btn-danger rounded-3 px-3 fw-semibold">Delete</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function filterAppointments() {
      const query = document.getElementById("searchInput").value.toLowerCase().trim();
      const records = document.querySelectorAll(".appointment-record");

      records.forEach(record => {
        const text = record.innerText.toLowerCase();
        record.style.display = text.includes(query) ? "" : "none";
      });
    }

    function confirmDelete(id) {
      const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
      document.getElementById('confirmDeleteBtn').href = `/admin/delete_patient/${id}`;
      modal.show();
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>