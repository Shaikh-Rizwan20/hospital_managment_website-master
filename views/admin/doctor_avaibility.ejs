<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Doctor Availability Schedule | Welcare Hospital</title>

  <!-- Google Font: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5.3 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    :root {
      --sidebar-width: 260px;
      /* Deep Teal & Emerald Clinical Palette */
      --primary: #0f766e;
      --primary-light: #14b8a6;
      --primary-subtle: #f0fdfa;
      --primary-border: #ccfbf1;
      --accent: #0284c7;
      --surface: #ffffff;
      --background: #f8fafc;
      --border: #e2e8f0;
      --text-main: #0f172a;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--background);
      color: var(--text-main);
      min-height: 100vh;
    }

    /* Pushes content away from fixed sidebar on desktop; resets on mobile */
    .schedule-wrapper {
      width: calc(100% - var(--sidebar-width));
      margin-left: var(--sidebar-width);
      padding: 2.5rem 1.5rem;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      transition: all 0.3s ease;
    }

    @media (max-width: 991.98px) {
      .schedule-wrapper {
        width: 100% !important;
        margin-left: 0 !important;
        padding: 1.25rem 0.75rem;
      }
    }

    .form-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: 0 12px 32px -4px rgba(15, 23, 42, 0.06);
      width: 100%;
      max-width: 820px;
      padding: 2.5rem;
    }

    /* Top Navigation Row for Back & Home */
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .nav-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 0.9rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      background-color: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .nav-action-btn:hover {
      background-color: var(--primary-subtle);
      border-color: var(--primary-border);
      color: var(--primary);
    }

    .form-header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }

    .header-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, #ccfbf1, #e0f2fe);
      color: var(--primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .doctor-input-group .input-group-text {
      background-color: var(--primary-subtle);
      border-color: var(--border);
      color: var(--primary);
    }

    .day-card {
      background-color: #ffffff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      margin-bottom: 0.85rem;
      transition: all 0.2s ease;
    }

    .day-card:hover {
      border-color: var(--primary-light);
      box-shadow: 0 4px 14px rgba(15, 118, 110, 0.05);
    }

    .day-card.day-off {
      opacity: 0.55;
      background-color: #f8fafc;
      border-color: var(--border);
    }

    .day-title {
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--text-main);
    }

    .day-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background-color: var(--primary-subtle);
      color: var(--primary);
      font-size: 0.85rem;
      margin-right: 0.5rem;
    }

    .form-control {
      border-radius: 10px;
      border: 1px solid var(--border);
      font-size: 0.9rem;
      padding: 0.65rem 0.85rem;
      background-color: #fcfdfe;
      color: var(--text-main);
    }

    .form-control:focus {
      background-color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.12);
    }

    .form-check-input:checked {
      background-color: var(--primary);
      border-color: var(--primary);
    }

    .submit-btn {
      background: linear-gradient(135deg, #0f766e, #0d9488);
      color: #ffffff;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      padding: 0.85rem 1.75rem;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(15, 118, 110, 0.25);
    }

    .submit-btn:hover {
      background: linear-gradient(135deg, #115e59, #0f766e);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(15, 118, 110, 0.35);
      color: #ffffff;
    }

    @media (max-width: 576px) {
      .form-container {
        padding: 1.5rem 1rem;
      }
      .day-card {
        padding: 1rem 0.75rem;
      }
    }
  </style>
</head>
<body>

  <div class="schedule-wrapper">
    <div class="form-container">
      
      <!-- Previous & Home Action Buttons -->
      <div class="nav-actions">
        <a href="javascript:history.back()" class="nav-action-btn" title="Go back to previous page">
          <i class="bi bi-arrow-left"></i> Previous
        </a>
        <a href="/admin/appointment" class="nav-action-btn" title="Go to Dashboard/Home">
          <i class="bi bi-house-door"></i> Home
        </a>
      </div>

      <!-- Header -->
      <div class="form-header d-flex align-items-center gap-3">
        <div class="header-icon">
          <i class="bi bi-clock-history"></i>
        </div>
        <div>
          <h4 class="fw-bold mb-1">Doctor Availability Schedule</h4>
          <p class="text-muted small mb-0">Configure active weekly shifts and appointment slots</p>
        </div>
      </div>

      <form action="/admin/submit" method="POST">
        
        <!-- Doctor Info -->
        <div class="mb-4">
          <label for="doctor_name" class="form-label fw-bold small text-muted text-uppercase">
            Doctor Name / Staff ID <span class="text-danger">*</span>
          </label>
          <div class="input-group doctor-input-group">
            <span class="input-group-text border-end-0 rounded-start-3">
              <i class="bi bi-person-badge"></i>
            </span>
            <input 
              type="text" 
              class="form-control border-start-0 rounded-end-3" 
              id="doctor_name" 
              name="doctor_name" 
              placeholder="e.g. Dr. Sarah Jenkins, MD" 
              required 
            />
          </div>
        </div>

        <!-- Weekly Days Schedule -->
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="form-label fw-bold small text-muted text-uppercase mb-0">
              Shift Hours (Start & End Time)
            </span>
            <span class="small text-muted d-none d-md-inline">Toggle switch to mark as Day Off</span>
          </div>

          <!-- Monday -->
          <div class="day-card" id="card_monday">
            <div class="row align-items-center g-2">
              <div class="col-12 col-md-3 d-flex align-items-center justify-content-between">
                <span class="day-title">
                  <span class="day-badge"><i class="bi bi-calendar4"></i></span>Monday
                </span>
                <div class="form-check form-switch d-md-none">
                  <input class="form-check-input" type="checkbox" id="off_monday" onchange="toggleDay('monday')">
                  <label class="form-check-label small text-muted" for="off_monday">Off</label>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="monday_start" id="monday_start" value="09:00" />
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="monday_end" id="monday_end" value="17:00" />
              </div>
              <div class="col-12 col-md-1 text-end d-none d-md-block">
                <div class="form-check form-switch d-inline-block" title="Mark as Day Off">
                  <input class="form-check-input" type="checkbox" id="off_monday_desk" onchange="toggleDay('monday')">
                </div>
              </div>
            </div>
          </div>

          <!-- Tuesday -->
          <div class="day-card" id="card_tuesday">
            <div class="row align-items-center g-2">
              <div class="col-12 col-md-3 d-flex align-items-center justify-content-between">
                <span class="day-title">
                  <span class="day-badge"><i class="bi bi-calendar4"></i></span>Tuesday
                </span>
                <div class="form-check form-switch d-md-none">
                  <input class="form-check-input" type="checkbox" id="off_tuesday" onchange="toggleDay('tuesday')">
                  <label class="form-check-label small text-muted" for="off_tuesday">Off</label>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="tuesday_start" id="tuesday_start" value="09:00" />
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="tuesday_end" id="tuesday_end" value="17:00" />
              </div>
              <div class="col-12 col-md-1 text-end d-none d-md-block">
                <div class="form-check form-switch d-inline-block" title="Mark as Day Off">
                  <input class="form-check-input" type="checkbox" id="off_tuesday_desk" onchange="toggleDay('tuesday')">
                </div>
              </div>
            </div>
          </div>

          <!-- Wednesday -->
          <div class="day-card" id="card_wednesday">
            <div class="row align-items-center g-2">
              <div class="col-12 col-md-3 d-flex align-items-center justify-content-between">
                <span class="day-title">
                  <span class="day-badge"><i class="bi bi-calendar4"></i></span>Wednesday
                </span>
                <div class="form-check form-switch d-md-none">
                  <input class="form-check-input" type="checkbox" id="off_wednesday" onchange="toggleDay('wednesday')">
                  <label class="form-check-label small text-muted" for="off_wednesday">Off</label>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="wednesday_start" id="wednesday_start" value="09:00" />
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="wednesday_end" id="wednesday_end" value="17:00" />
              </div>
              <div class="col-12 col-md-1 text-end d-none d-md-block">
                <div class="form-check form-switch d-inline-block" title="Mark as Day Off">
                  <input class="form-check-input" type="checkbox" id="off_wednesday_desk" onchange="toggleDay('wednesday')">
                </div>
              </div>
            </div>
          </div>

          <!-- Thursday -->
          <div class="day-card" id="card_thursday">
            <div class="row align-items-center g-2">
              <div class="col-12 col-md-3 d-flex align-items-center justify-content-between">
                <span class="day-title">
                  <span class="day-badge"><i class="bi bi-calendar4"></i></span>Thursday
                </span>
                <div class="form-check form-switch d-md-none">
                  <input class="form-check-input" type="checkbox" id="off_thursday" onchange="toggleDay('thursday')">
                  <label class="form-check-label small text-muted" for="off_thursday">Off</label>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="thursday_start" id="thursday_start" value="09:00" />
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="thursday_end" id="thursday_end" value="17:00" />
              </div>
              <div class="col-12 col-md-1 text-end d-none d-md-block">
                <div class="form-check form-switch d-inline-block" title="Mark as Day Off">
                  <input class="form-check-input" type="checkbox" id="off_thursday_desk" onchange="toggleDay('thursday')">
                </div>
              </div>
            </div>
          </div>

          <!-- Friday -->
          <div class="day-card" id="card_friday">
            <div class="row align-items-center g-2">
              <div class="col-12 col-md-3 d-flex align-items-center justify-content-between">
                <span class="day-title">
                  <span class="day-badge"><i class="bi bi-calendar4"></i></span>Friday
                </span>
                <div class="form-check form-switch d-md-none">
                  <input class="form-check-input" type="checkbox" id="off_friday" onchange="toggleDay('friday')">
                  <label class="form-check-label small text-muted" for="off_friday">Off</label>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="friday_start" id="friday_start" value="09:00" />
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="friday_end" id="friday_end" value="17:00" />
              </div>
              <div class="col-12 col-md-1 text-end d-none d-md-block">
                <div class="form-check form-switch d-inline-block" title="Mark as Day Off">
                  <input class="form-check-input" type="checkbox" id="off_friday_desk" onchange="toggleDay('friday')">
                </div>
              </div>
            </div>
          </div>

          <!-- Saturday -->
          <div class="day-card" id="card_saturday">
            <div class="row align-items-center g-2">
              <div class="col-12 col-md-3 d-flex align-items-center justify-content-between">
                <span class="day-title">
                  <span class="day-badge"><i class="bi bi-calendar4"></i></span>Saturday
                </span>
                <div class="form-check form-switch d-md-none">
                  <input class="form-check-input" type="checkbox" id="off_saturday" onchange="toggleDay('saturday')">
                  <label class="form-check-label small text-muted" for="off_saturday">Off</label>
                </div>
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="saturday_start" id="saturday_start" value="10:00" />
              </div>
              <div class="col-6 col-md-4">
                <input type="time" class="form-control" name="saturday_end" id="saturday_end" value="14:00" />
              </div>
              <div class="col-12 col-md-1 text-end d-none d-md-block">
                <div class="form-check form-switch d-inline-block" title="Mark as Day Off">
                  <input class="form-check-input" type="checkbox" id="off_saturday_desk" onchange="toggleDay('saturday')">
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Action Buttons -->
        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-3 border-top">
          <button type="reset" class="btn btn-light rounded-3 px-4 fw-semibold text-muted">
            Reset
          </button>
          <button type="submit" class="submit-btn d-inline-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-check2-circle"></i> Save Availability Schedule
          </button>
        </div>

      </form>
    </div>
  </div>

  <script>
    function toggleDay(day) {
      const card = document.getElementById(`card_${day}`);
      const startInput = document.getElementById(`${day}_start`);
      const endInput = document.getElementById(`${day}_end`);
      const mobCheck = document.getElementById(`off_${day}`);
      const deskCheck = document.getElementById(`off_${day}_desk`);

      const isOff = mobCheck.checked || (deskCheck && deskCheck.checked);
      if (mobCheck) mobCheck.checked = isOff;
      if (deskCheck) deskCheck.checked = isOff;

      if (isOff) {
        card.classList.add('day-off');
        startInput.disabled = true;
        endInput.disabled = true;
      } else {
        card.classList.remove('day-off');
        startInput.disabled = false;
        endInput.disabled = false;
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>