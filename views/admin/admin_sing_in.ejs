<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Segoe UI', sans-serif;
    }

    .login-box {
      background: #fff;
      padding: 40px 35px;
      border-radius: 18px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      animation: fadeIn 0.6s ease-in-out;
    }

    @keyframes fadeIn {
      from { transform: translateY(10px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .login-title {
      font-weight: 700;
      color: #1e3c72;
      text-align: center;
    }

    .form-control {
      border-radius: 10px;
      padding: 12px;
    }

    .btn-login {
      background: linear-gradient(to right, #1e3c72, #2a5298);
      border-radius: 50px;
      padding: 12px;
      color: #fff;
      font-weight: 600;
      transition: 0.3s;
    }

    .btn-login:hover {
      transform: scale(1.03);
      background: linear-gradient(to right, #2a5298, #1e3c72);
    }

    .register-link {
      display: block;
      text-align: center;
      margin-top: 12px;
      font-weight: 600;
    }

    .register-link a {
      color: #1e3c72;
      text-decoration: none;
    }

    .register-link a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>

  <div class="login-box">
    <h2 class="login-title mb-4">Admin Login</h2>

    <form action="/admin/save_admin" method="POST">
      <div class="mb-3">
        <label class="form-label fw-semibold">Email</label>
        <input type="email" class="form-control" name="email" placeholder="Enter your email" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Password</label>
        <input type="password" class="form-control" name="password" placeholder="Enter your password" required>
      </div>

      <button type="submit" class="btn btn-login w-100 mt-2">Sign In</button>

      <div class="register-link">
        Don’t have an account? <a href="/admin/admin_registration">Register</a>
      </div>
    </form>
  </div>

</body>
</html>
